/* Parser.cup */
package ParserLexer;
import java_cup.runtime.*;

/*
   Este parser fue hecho así para validar la conexión con el scanner,
   implementando reglas de producción simples para comprobar el reconocimiento de tokens
   y la transición entre el análisis léxico y sintáctico.
*/


parser code {:
    // declaración del scanner
    private Lexer s;
    public Parser(Lexer s) { this.s = s; } // constructor

    public void syntax_error(Symbol s) { // manejo de errores - es solo de prueba por ahora
        System.err.println("Error de sintaxis en línea " + (s.left + 1) + ", columna " + (s.right + 1));
        System.err.println("Token inesperado: " + sym.terminalNames[s.sym]);
    }
:}

/* Inicialización */
scan with {: return s.next_token(); :};

/* ------------------------------------------------------------------
   TERMINALES (declara solo los que uses de verdad para reducir warnings)
------------------------------------------------------------------ */
terminal IDENTIFICADOR, INTEGER, FLOAT, BOOL, BOOL_LITERAL, STRING, CHAR;
terminal L_INTEGER, FLOAT_LITERAL, CHAR_LITERAL, STRING_LITERAL;
terminal ASIGNA, SUMA, RESTA, DIVISION, MULTIPLICACION, MODULE, POTENCIA;
terminal INCREMENTO, DECREMENTO;
terminal MENOR, MENOROIGUAL, MAYOR, MAYOROIGUAL, IGUALDAD, DIFERENTE;
terminal CONJUNCION, DISYUNCION, NEGACION;
terminal IF, ELSE, WHILE, FOR, SWITCH, CASE, DEFAULT, BREAK, RETURN, DOS_PUNTOS;
terminal PRINT, READ, MAIN;
terminal ABRECUENTO, CIERRACUENTO, ABREREGALO, CIERRAREGALO, ABREEMPAQUE, CIERRAEMPAQUE;
terminal PUNTO_Y_COMA, COMA, UNKNOWN_TOKEN;

/* ------------------------------------------------------------------
   NO TERMINALES que sí vamos a usar
------------------------------------------------------------------ */
non terminal programa, bloque, lista_sentencias, sentencia;
non terminal declaracion, declaracion_aux, asignacion, tipo_dato, expresion, literal;
non terminal control_estructuras, if_estructura, while_estructura, for_estructura;
non terminal switch_estructura, case_blocks, case_block, default_block;

/* ------------------------------------------------------------------
   PRODUCCIÓN INICIAL
------------------------------------------------------------------ */
start with programa;

/* ------------------------------------------------------------------
   REGLAS DE PRODUCCIÓN
------------------------------------------------------------------ */

programa ::=
    MAIN bloque
  | /* epsilon */
  ;

bloque ::=
    ABRECUENTO lista_sentencias CIERRACUENTO
  | /* epsilon */
  ;

lista_sentencias ::=
    lista_sentencias sentencia
  | sentencia
  ;

sentencia ::=
    declaracion
  | asignacion
  | control_estructuras
  | PRINT ABREREGALO expresion CIERRAREGALO PUNTO_Y_COMA
  | READ ABREREGALO IDENTIFICADOR CIERRAREGALO PUNTO_Y_COMA
  | RETURN expresion PUNTO_Y_COMA
  | BREAK PUNTO_Y_COMA
  ;

/* ------------------------------------------------------------------
   La parte "declaracion_aux" determina si termina en ";"
   o " = expr ;"
   o "[ L_INTEGER ] ;"
------------------------------------------------------------------ */
declaracion ::=
    tipo_dato IDENTIFICADOR declaracion_aux
  ;

/* declaracion_aux:
   - ;
   - = expr ;
   - [ L_INTEGER ] ;
*/
declaracion_aux ::=
    PUNTO_Y_COMA
  | ASIGNA expresion PUNTO_Y_COMA
  | ABREEMPAQUE L_INTEGER CIERRAEMPAQUE PUNTO_Y_COMA
  ;

tipo_dato ::=
    INTEGER
  | FLOAT
  | BOOL
  | CHAR
  | STRING
  ;

/* ------------------------------------------------------------------
   Asignación
   var = expr;
   var[expr] = expr;
------------------------------------------------------------------ */
asignacion ::=
    IDENTIFICADOR ASIGNA expresion PUNTO_Y_COMA
  | IDENTIFICADOR ABREEMPAQUE expresion CIERRAEMPAQUE ASIGNA expresion PUNTO_Y_COMA
  ;

/* ------------------------------------------------------------------
   Estructuras de Control (if, while, for, switch)
------------------------------------------------------------------ */
control_estructuras ::=
    if_estructura
  | while_estructura
  | for_estructura
  | switch_estructura
  ;

if_estructura ::=
    IF ABREREGALO expresion CIERRAREGALO bloque
  | IF ABREREGALO expresion CIERRAREGALO bloque ELSE bloque
  ;

while_estructura ::=
    WHILE ABREREGALO expresion CIERRAREGALO bloque
  ;

/*
   For (ejemplo):
   for(asignacion expr; asignacion) bloque
   Ajusta la sintaxis si deseas init; cond; inc
*/
for_estructura ::=
    FOR ABREREGALO asignacion expresion PUNTO_Y_COMA asignacion CIERRAREGALO bloque
  ;

switch_estructura ::=
    SWITCH ABREREGALO expresion CIERRAREGALO ABRECUENTO case_blocks CIERRACUENTO
  ;

case_blocks ::=
    case_blocks case_block
  | case_block
  | default_block
  ;

case_block ::=
    CASE L_INTEGER DOS_PUNTOS bloque
  | CASE CHAR_LITERAL DOS_PUNTOS bloque
  ;

default_block ::=
    DEFAULT DOS_PUNTOS bloque
  ;

/* ------------------------------------------------------------------
   Expresión (básico):
   - literal, identificador, id[expr]
   - (hay que ampliar con +, -, etc.)
------------------------------------------------------------------ */
expresion ::=
    literal
  | IDENTIFICADOR
  | IDENTIFICADOR ABREEMPAQUE expresion CIERRAEMPAQUE
  ;

/* literales: enteros, float, char, string, bool */
literal ::=
    L_INTEGER
  | FLOAT_LITERAL
  | CHAR_LITERAL
  | STRING_LITERAL
  | BOOL_LITERAL
  ;

/* ------------------------------------------------------------------
   (Fin)
------------------------------------------------------------------ */
