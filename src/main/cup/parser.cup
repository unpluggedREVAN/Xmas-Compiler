/* ============================================================================
   parser.cup - Xmas-Compile (adaptado con estilo de output similar al parser de copia)
============================================================================ */

package ParserLexer;

import java_cup.runtime.*;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Stack;

/* ----------------------------------------------------------------------
   1) Sección de código del parser
---------------------------------------------------------------------- */
parser code {:
    /*
     * Clase interna para manejar la información de cada símbolo en la Tabla.
     * Similar al SymbolData del parser "de copia".
     */
    public static class SymbolData {
        String lexeme;
        String type;
        int line;
        int column;
        String scope;
        Object value;

        public SymbolData(String lexeme, String type, int line, int column, String scope, Object value) {
            this.lexeme = lexeme;
            this.type = type;
            this.line = line;
            this.column = column;
            this.scope = scope;
            this.value = value;
        }
    }

    // Lista de errores sintácticos (similar a 'syntaxErrors' del parser de copia):
    private List<String> errores = new ArrayList<>();

    // Estructura para almacenar scopes y símbolos (similar a 'symbolTable'):
    private HashMap<String, ArrayList<SymbolData>> tablaSimbolos = new HashMap<>();

    // Pila de scopes (similar a 'scopeStack'):
    private Stack<String> scopeStack = new Stack<>();

    // Scope actual. Iniciamos en 'global'.
    public String currentScope = "global";

    // Lista opcional para estructuras de control, si se desea rastrear (análogo a controlStructures):
    private List<String> estructurasControl = new ArrayList<>();

    // Contador para crear scopes anónimos (bloques), si se necesita:
    private int blockCounter = 0;

    // Referencia a nuestro lexer
    private Lexer s;

    /* ----------------------------------------------------------------------
       Constructor
    ---------------------------------------------------------------------- */
    public Parser(Lexer s) {
        this.s = s;
        scopeStack.push("global");  // Primer scope
    }

    /* ----------------------------------------------------------------------
       Sobrescritura de métodos de error-recovery y reporte
       (adaptando estilo del parser de copia)
    ---------------------------------------------------------------------- */
    @Override
    public void syntax_error(Symbol sym) {
        // Llamamos a nuestra propia función de reporte
        report_error("Token inesperado", sym);
    }

    @Override
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        errores.add("** Error sintáctico irrecuperable ** en token: "
                    + (cur_token != null ? cur_token.value : "null")
                    + " (línea " + (cur_token != null ? (cur_token.left + 1) : -1)
                    + ", col "   + (cur_token != null ? (cur_token.right + 1) : -1) + ")");
        // No lanzamos excepción para no abortar, pero CUP por defecto lo haría.
        // Si quisiéramos abortar, podríamos descomentar:
        // throw new RuntimeException("Unrecoverable syntax error");
    }

    @Override
    public void report_fatal_error(String message, Object info) {
        // Similar a la estrategia del parser de copia
        report_error(message, info);
        // Podemos dejar que continúe o forzar la excepción.
        // throw new RuntimeException("Fatal error: " + message);
    }

    @Override
    public void report_error(String message, Object info) {
        if (info instanceof Symbol) {
            Symbol sym = (Symbol) info;
            String errorMsg = "Error: " + message
                              + " cerca del token '" + sym.value + "' "
                              + "(línea " + (sym.left + 1) + ", col " + (sym.right + 1) + ")";
            errores.add(errorMsg);
            System.err.println(errorMsg);
        } else {
            String errorMsg = "Error: " + message;
            errores.add(errorMsg);
            System.err.println(errorMsg);
        }
    }

    /* ----------------------------------------------------------------------
       Manejo de Tabla de Símbolos y scopes
    ---------------------------------------------------------------------- */
    // Empujar un nuevo scope a la pila
    private void pushScope(String newScope) {
        scopeStack.push(newScope);
        currentScope = newScope;
        if (!tablaSimbolos.containsKey(currentScope)) {
            tablaSimbolos.put(currentScope, new ArrayList<SymbolData>());
        }
    }

    // Retirar scope de la pila
    private void popScope() {
        if (!scopeStack.isEmpty()) {
            scopeStack.pop();
            currentScope = scopeStack.isEmpty() ? "global" : scopeStack.peek();
        }
    }

    // Crear tabla (similar a la idea de crear un scope al entrar en función):
    public void crearTabla(String type, String funcName, int line, int col) {
        // Emulamos lo que hacíamos antes, pero usando pushScope
        System.out.println("Se crea nuevo scope para función: " + funcName);
        pushScope(funcName);

        // Si quisiéramos guardar metadata de la función como símbolo, lo hacemos:
        SymbolData funcData = new SymbolData(funcName, "funcType:" + type, line, col, currentScope, null);
        tablaSimbolos.get(currentScope).add(funcData);
    }

    // Agregar símbolo a la tabla
    public void addSimbolo(String scope, String lexeme, int line, int col, String type) {
        if (!tablaSimbolos.containsKey(scope)) {
            tablaSimbolos.put(scope, new ArrayList<SymbolData>());
        }
        SymbolData data = new SymbolData(lexeme, type, line, col, scope, null);
        tablaSimbolos.get(scope).add(data);
        System.out.println("Símbolo agregado -> "
                           + "lex:'" + lexeme + "', tipo:'" + type
                           + "', scope:'" + scope + "', línea:" + line + ", col:" + col);
    }

    // Para cuando terminamos un bloque, si quisiéramos:
    private void closeCurrentScope() {
        popScope();
    }

    // Método para impresión final al concluir el parseo (similar a printSummary):
    public void imprimirTablaSimbolos() {
        System.out.println("\n--- 1) TABLAS DE SÍMBOLOS ---");
        System.out.println("Lexema\tTipo\tLínea\tCol\tScope\tValor");
        System.out.println("---------------------------------------------");
        for (String scopeKey : tablaSimbolos.keySet()) {
            for (SymbolData sd : tablaSimbolos.get(scopeKey)) {
                System.out.printf("%s\t%s\t%d\t%d\t%s\t%s\n",
                                  sd.lexeme,
                                  sd.type,
                                  sd.line,
                                  sd.column,
                                  sd.scope,
                                  (sd.value != null ? sd.value.toString() : "null"));
            }
        }

        System.out.println("\n--- 2) ERRORES SINTÁCTICOS ---");
        if (errores.isEmpty()) {
            System.out.println("No se encontraron errores sintácticos.");
        } else {
            for (String err : errores) {
                System.out.println("* " + err);
            }
        }

        // Si quisiéramos mostrar estructuras de control, similar al "parser de copia":
        if (!estructurasControl.isEmpty()) {
            System.out.println("\n--- 3) ESTRUCTURAS DE CONTROL DETECTADAS ---");
            for (String info : estructurasControl) {
                System.out.println("- " + info);
            }
        } else {
            System.out.println("\n--- 3) ESTRUCTURAS DE CONTROL DETECTADAS ---");
            System.out.println("No se detectaron estructuras de control.");
        }

        System.out.println("\n--- 4) RESUMEN GENERAL ---");
        if (errores.isEmpty()) {
            System.out.println("Estado del archivo: VÁLIDO");
            System.out.println("Errores encontrados: 0");
        } else {
            System.out.println("Estado del archivo: INVÁLIDO");
            System.out.println("Errores encontrados: " + errores.size());
        }

        System.out.println("\nFin del reporte.\n");
    }

    // Por si deseamos rastrear alguna estructura de control (while, for, if, etc.)
    public void addControlStructure(String info) {
        estructurasControl.add(info);
    }

:}

/* ----------------------------------------------------------------------
   2) Conexión con el scanner
---------------------------------------------------------------------- */
scan with {:
    return s.next_token();
:};

/* ----------------------------------------------------------------------
   3) Declaración de TERMINALES
---------------------------------------------------------------------- */
// Nota: se elimina FINREGALO porque no se usa
terminal String IDENTIFICADOR;
terminal INTEGER, FLOAT, BOOL, STRING, CHAR;
terminal L_INTEGER, FLOAT_LITERAL, BOOL_LITERAL, CHAR_LITERAL, STRING_LITERAL;
terminal ASIGNA;
terminal INCREMENTO, DECREMENTO, UNKNOWN_TOKEN;
terminal SUMA, RESTA, DIVISION, MULTIPLICACION, MODULE, POTENCIA;
terminal MENOR, MENOROIGUAL, MAYOR, MAYOROIGUAL, IGUALDAD, DIFERENTE;
terminal CONJUNCION, DISYUNCION, NEGACION;
terminal IF, ELSE, WHILE, FOR, SWITCH, CASE, DEFAULT, BREAK, RETURN, DOS_PUNTOS;
terminal PRINT, READ, MAIN;
terminal ABRECUENTO, CIERRACUENTO, ABREREGALO, CIERRAREGALO, ABREEMPAQUE, CIERRAEMPAQUE;
terminal PUNTO_Y_COMA, COMA;

/* ----------------------------------------------------------------------
   4) Declaración de NO TERMINALES
---------------------------------------------------------------------- */
non terminal programa, declaracionesGlobales, globalDeclaracion, maindeclaracion;
non terminal bloque, lista_sentencias, sentencia;
non terminal declaracion, declaracion_aux, asignacion, tipo_dato;
non terminal control_estructuras, if_estructura, while_estructura, for_estructura, switch_estructura;
non terminal case_blocks, case_block, default_block;
non terminal funcion, parametros, lista_parametros, param_dec;
non terminal expresion, array_init, array_item, array_item_list;
non terminal customError; // Para manejo recursivo de error
non terminal argumentos, lista_argumentos;

/* ----------------------------------------------------------------------
   5) Precedencia
---------------------------------------------------------------------- */
precedence right POTENCIA;
precedence right NEGACION, RESTA;
precedence left MULTIPLICACION, DIVISION, MODULE;
precedence left SUMA, RESTA;
precedence left MENOR, MENOROIGUAL, MAYOR, MAYOROIGUAL;
precedence left IGUALDAD, DIFERENTE;
precedence left CONJUNCION;
precedence left DISYUNCION;

/* ----------------------------------------------------------------------
   6) Producción inicial
---------------------------------------------------------------------- */
start with programa;

/* ----------------------------------------------------------------------
   7) Reglas de Producción
---------------------------------------------------------------------- */

/* A) Estructura General del Programa */
programa ::=
    declaracionesGlobales maindeclaracion bloque
       {:
         System.out.println("Regla 'programa' con declaracionesGlobales + MAIN");
         // Al finalizar el parseo, imprimimos el reporte:
         parser.imprimirTablaSimbolos();
       :}
  | maindeclaracion bloque
       {:
         System.out.println("Regla 'programa' con sólo MAIN");
         // Al finalizar el parseo, imprimimos el reporte:
         parser.imprimirTablaSimbolos();
       :}
  ;

/* Main funciones */
maindeclaracion ::=
MAIN
 | MAIN ABREREGALO CIERRAREGALO
 | tipo_dato MAIN
 |  tipo_dato MAIN ABREREGALO CIERRAREGALO
 ;

/* declaracionesGlobales -> (globalDeclaracion)+ */
declaracionesGlobales ::=
    declaracionesGlobales globalDeclaracion
  | globalDeclaracion
  ;

/* globalDeclaracion -> declaracion | funcion */
globalDeclaracion ::=
    declaracion
  |  funcion
  ;

/* B) Bloque */
bloque ::=
    ABRECUENTO lista_sentencias CIERRACUENTO
      {:
        System.out.println("Regla 'bloque' ejecutada.");
      :}
  | /* epsilon */
  ;

/* lista_sentencias: una o más sentencias */
lista_sentencias ::=
    lista_sentencias sentencia
      {:
        System.out.println("Regla 'lista_sentencias' procesando lista.");
      :}
  | sentencia
      {:
        System.out.println("Regla 'lista_sentencias' procesando sentencia.");
      :}
  ;

/* ----------------------------------------------------------------------
   C) Sentencia
---------------------------------------------------------------------- */
sentencia ::=
    declaracion
  | asignacion
  | control_estructuras
  | PRINT ABREREGALO expresion:e CIERRAREGALO PUNTO_Y_COMA
      {:
         System.out.println("Imprimiendo la expresión: " + e);
      :}
  | READ ABREREGALO IDENTIFICADOR:id CIERRAREGALO PUNTO_Y_COMA
      {:
         System.out.println("Leyendo a variable: " + id);
      :}
  | RETURN expresion:ret PUNTO_Y_COMA
      {:
         System.out.println("Return con expr: " + ret);
      :}
  | BREAK PUNTO_Y_COMA

  /* Manejo de error */
  | customError PUNTO_Y_COMA
      {:
         System.err.println("Recuperado un error en sentencia con customError;");
         RESULT = "errStmt";
      :}

  /* Producción para token desconocido */
  | UNKNOWN_TOKEN:unk
      {:
         parser.report_error("Sentencia desconocida, token ignorado", parser.scan());
         System.err.println("Sentencia desconocida: " + unk);
      :}
  ;

/* customError ::= customError error | error ; */
customError ::=
    customError error
      {:
        System.err.println("Absorbiendo otro token 'error' en customError");
      :}
  | error
      {:
        System.err.println("Detectado token 'error' en customError");
        RESULT = "customErrBase";
      :}
  ;

/* ----------------------------------------------------------------------
   D) Declaraciones
---------------------------------------------------------------------- */
declaracion ::=
    tipo_dato:td IDENTIFICADOR:myid declaracion_aux:aux
    {:
      String t = (String) td;

      System.out.println("Declaración detectada:");
      System.out.println("- Tipo de dato: " + t);
      System.out.println("- Variable: " + myid);
      System.out.println("- Inicialización: " + (aux != null ? aux : "Ninguna"));

      int line = myidleft + 1;
      int col  = myidright + 1;
      parser.addSimbolo(parser.currentScope, myid, line, col, t);

      RESULT = null;
    :}
  ;

declaracion_aux ::=
    PUNTO_Y_COMA
      {:
        RESULT = null;
      :}
  | ASIGNA expresion:ex PUNTO_Y_COMA
      {:
        RESULT = " = " + ex;
      :}
  | ABREEMPAQUE expresion:idx CIERRAEMPAQUE PUNTO_Y_COMA
      {:
        RESULT = "[ " + idx + " ]";
      :}
  | ABREEMPAQUE expresion:idx CIERRAEMPAQUE ASIGNA array_init:ai PUNTO_Y_COMA
      {:
        RESULT = "[ " + idx + " ] = " + ai;
      :}
  ;

/* array_init ::= { array_item_list } */
array_init ::=
    ABRECUENTO array_item_list:ail CIERRACUENTO
      {:
        RESULT = "{ " + ail + " }";
      :}
  ;

array_item_list ::=
    array_item:ai
      {:
        RESULT = ai;
      :}
  | array_item_list:ail COMA array_item:ai
      {:
        RESULT = (String)ail + ", " + (String)ai;
      :}
  ;

array_item ::=
    CHAR_LITERAL:ch
      {:
        RESULT = "'"+ch+"'";
      :}
  | L_INTEGER:li
      {:
        RESULT = li.toString();
      :}
  | FLOAT_LITERAL:fl
      {:
        RESULT = fl.toString();
      :}
  | IDENTIFICADOR:id
      {:
        RESULT = id;
      :}
  | STRING_LITERAL:st
      {:
        RESULT = "\""+st+"\"";
      :}
  | BOOL_LITERAL:boo
      {:
        RESULT = boo.toString();
      :}
  ;

/* Tipos base */
tipo_dato ::=
    INTEGER  {: RESULT = "int";   :}
  | FLOAT    {: RESULT = "float"; :}
  | BOOL     {: RESULT = "bool";  :}
  | CHAR     {: RESULT = "char";  :}
  | STRING   {: RESULT = "string";:}
  ;

/* ----------------------------------------------------------------------
   E) Asignaciones
---------------------------------------------------------------------- */
asignacion ::=
    IDENTIFICADOR:idVar ASIGNA expresion:ex PUNTO_Y_COMA
      {:
        System.out.println("Asignación simple a variable " + idVar + " con expr: " + ex);
        RESULT = "assign(" + idVar + "=" + ex + ")";
      :}
  | IDENTIFICADOR:idVar ABREEMPAQUE expresion:pos CIERRAEMPAQUE ASIGNA expresion:rhs PUNTO_Y_COMA
      {:
        System.out.println("Asignación a arreglo " + idVar + "[" + pos + "] = " + rhs);
        RESULT = "assignArr(" + idVar + "["+pos+"]="+rhs+")";
      :}
  ;

/* ----------------------------------------------------------------------
   F) Declaración de Funciones
---------------------------------------------------------------------- */
funcion ::=
    tipo_dato:td IDENTIFICADOR:funId
    {:
        // Al reconocer la función, creamos un nuevo scope
        String t = (String) td;
        int line = funIdleft + 1;
        int col  = funIdright + 1;
        parser.crearTabla(t, funId, line, col);
    :}
    ABREREGALO parametros:p CIERRAREGALO bloque:b
    {:
       String pStr = (String) p;
       if (pStr.isEmpty()) pStr = "0 params";

       String t = (String) td;

       System.out.println("Función declarada: " + funId
                          + " de tipo " + t
                          + ", con params: " + pStr
                          + " y un bloque.");

       // Al terminar la función, regresamos scope al global (o popScope):
       parser.currentScope = "global";
       parser.popScope();

       RESULT = "func["+t+" "+funId+"("+pStr+")]";
    :}
  ;

/* parametros -> (lista_parametros)? */
parametros ::=
    /* epsilon */
      {:
        RESULT = "";
      :}
  | lista_parametros:pp
      {:
        RESULT = pp;
      :}
  ;

/* lista_parametros -> param_dec (, param_dec)* */
lista_parametros ::=
    param_dec:pd
      {:
        RESULT = pd;
      :}
  | lista_parametros:lp COMA param_dec:pd
      {:
        RESULT = (String)lp + ", " + (String)pd;
      :}
  ;

/* param_dec -> tipo_dato IDENTIFICADOR */
param_dec ::=
    tipo_dato:td IDENTIFICADOR:pid
      {:
        String t = (String) td;
        String paramStr = t + " " + pid;
        System.out.println("Parametro: " + paramStr);

        int line = pidleft + 1;
        int col  = pidright + 1;
        parser.addSimbolo(parser.currentScope, pid, line, col, t);

        RESULT = paramStr;
      :}
  ;

/* ----------------------------------------------------------------------
   G) Estructuras de Control
---------------------------------------------------------------------- */
control_estructuras ::=
    if_estructura
  | while_estructura
  | for_estructura
  | switch_estructura
  ;

/* if */
if_estructura ::=
    IF ABREREGALO expresion:cond CIERRAREGALO bloque:b
      {:
        RESULT = "if("+cond+")"+b;
        parser.addControlStructure("Se detectó un 'if' con condición: " + cond);
      :}
  | IF ABREREGALO expresion:cond CIERRAREGALO bloque:b1 ELSE bloque:b2
      {:
        RESULT = "if("+cond+")"+b1+" else "+b2;
        parser.addControlStructure("Se detectó un 'if-else' con condición: " + cond);
      :}
  | IF ABREREGALO error CIERRAREGALO bloque:bl
      {:
        parser.report_error("Error en condición de 'if'", parser.scan());
        RESULT = "ifError"+bl;
      :}
  ;

/* while */
while_estructura ::=
    WHILE ABREREGALO expresion:cond CIERRAREGALO bloque:bl
      {:
        RESULT = "while("+cond+")"+bl;
        parser.addControlStructure("Se detectó un 'while' con condición: " + cond);
      :}
  | WHILE ABREREGALO error CIERRAREGALO bloque:bl
      {:
        parser.report_error("Error en condición de 'while'", parser.scan());
        RESULT = "whileError"+bl;
      :}
  ;

/* for */
for_estructura ::=
    FOR ABREREGALO asignacion:ini COMA expresion:cond COMA expresion:step CIERRAREGALO bloque:bl
      {:
        RESULT = "for("+ini+", "+cond+", "+step+")"+bl;
        parser.addControlStructure("Se detectó un 'for' con inicialización: " + ini
                                   + ", condición: " + cond
                                   + ", step: " + step);
      :}
  | FOR ABREREGALO error CIERRAREGALO bloque:bl
      {:
        parser.report_error("Error en 'for'", parser.scan());
        RESULT = "forError"+bl;
      :}
  ;

/* switch */
switch_estructura ::=
    SWITCH ABREREGALO expresion:sw CIERRAREGALO ABRECUENTO case_blocks:cs CIERRACUENTO
      {:
        RESULT = "switch("+sw+") { "+cs+" }";
        parser.addControlStructure("Se detectó un 'switch' con expresión: " + sw);
      :}
  | SWITCH ABREREGALO error CIERRAREGALO ABRECUENTO case_blocks:cs CIERRACUENTO
      {:
        parser.report_error("Error en 'switch'", parser.scan());
        RESULT = "switchError{ "+cs+" }";
      :}
  ;

case_blocks ::=
    case_blocks:prev case_block:cb
      {:
        RESULT = prev + " " + cb;
      :}
  | case_block:cb
      {:
        RESULT = cb;
      :}
  | default_block:db
      {:
        RESULT = db;
      :}
  ;

case_block ::=
    CASE L_INTEGER:li DOS_PUNTOS bloque:bl
      {:
        RESULT = "case "+li+": "+bl;
      :}
  | CASE CHAR_LITERAL:ch DOS_PUNTOS bloque:bl
      {:
        RESULT = "case '"+ch+"': "+bl;
      :}
  ;

/* default: block */
default_block ::=
    DEFAULT DOS_PUNTOS bloque:bl
      {:
        RESULT = "default: "+bl;
      :}
  ;

/* ----------------------------------------------------------------------
   H) Expresión con precedencia
---------------------------------------------------------------------- */
expresion ::=
    expresion:e1 DISYUNCION expresion:e2
      {:
        RESULT = "("+e1+" || "+e2+")";
      :}
  | expresion:e1 CONJUNCION expresion:e2
      {:
        RESULT = "("+e1+" && "+e2+")";
      :}
  | expresion:e1 IGUALDAD expresion:e2
      {:
        RESULT = "("+e1+" == "+e2+")";
      :}
  | expresion:e1 DIFERENTE expresion:e2
      {:
        RESULT = "("+e1+" != "+e2+")";
      :}
  | expresion:e1 MENOR expresion:e2
      {:
        RESULT = "("+e1+" < "+e2+")";
      :}
  | expresion:e1 MENOROIGUAL expresion:e2
      {:
        RESULT = "("+e1+" <= "+e2+")";
      :}
  | expresion:e1 MAYOR expresion:e2
      {:
        RESULT = "("+e1+" > "+e2+")";
      :}
  | expresion:e1 MAYOROIGUAL expresion:e2
      {:
        RESULT = "("+e1+" >= "+e2+")";
      :}
  | expresion:e1 SUMA expresion:e2
      {:
        RESULT = "("+e1+" + "+e2+")";
      :}
  | expresion:e1 RESTA expresion:e2
      {:
        RESULT = "("+e1+" - "+e2+")";
      :}
  | expresion:e1 MULTIPLICACION expresion:e2
      {:
        RESULT = "("+e1+" * "+e2+")";
      :}
  | expresion:e1 DIVISION expresion:e2
      {:
        RESULT = "("+e1+" / "+e2+")";
      :}
  | expresion:e1 MODULE expresion:e2
      {:
        RESULT = "("+e1+" % "+e2+")";
      :}
  | expresion:e1 POTENCIA expresion:e2
      {:
        RESULT = "("+e1+" ^ "+e2+")";
      :}
  | NEGACION expresion:e
      {:
        RESULT = "!"+e;
      :}
  | RESTA expresion:e
      {:
        RESULT = "-"+e;
      :}
  | INCREMENTO IDENTIFICADOR:id
      {:
        RESULT = "++"+id;
        System.out.println("Expresión: ++" + id);
      :}
  | DECREMENTO IDENTIFICADOR:id
      {:
        RESULT = "--"+id;
        System.out.println("Expresión: --" + id);
      :}
  | IDENTIFICADOR:id INCREMENTO
      {:
        RESULT = id+"++";
        System.out.println("Expresión: " + id + "++");
      :}
  | IDENTIFICADOR:id DECREMENTO
      {:
        RESULT = id+"--";
        System.out.println("Expresión: " + id + "--");
      :}
  | IDENTIFICADOR:id ABREREGALO argumentos:args CIERRAREGALO
      {:
        RESULT = id + "(" + args + ")";
        System.out.println("Llamada a función: " + id + " con argumentos: " + args);
      :}
  /* primarios */
  | IDENTIFICADOR:id
      {:
        RESULT = id;
      :}
  | L_INTEGER:lint
      {:
        RESULT = lint.toString();
      :}
  | FLOAT_LITERAL:flit
      {:
        RESULT = flit.toString();
      :}
  | CHAR_LITERAL:chl
      {:
        RESULT = "'"+chl+"'";
      :}
  | STRING_LITERAL:str
      {:
        RESULT = "\""+str+"\"";
      :}
  | BOOL_LITERAL:boo
      {:
        RESULT = boo.toString();
      :}
  | IDENTIFICADOR:arr ABREEMPAQUE expresion:ex CIERRAEMPAQUE
      {:
        RESULT = arr + "["+ex+"]";
      :}
  | ABREREGALO expresion:ex CIERRAREGALO
      {:
        RESULT = "("+ex+")";
      :}
  | error CIERRAREGALO
      {:
        parser.report_error("Error en expresión. Recuperado hasta ')'", parser.scan());
        RESULT = "errorExpr";
      :}
  ;

argumentos ::=
    /* epsilon: llamada sin argumentos */
      {:
        RESULT = "";
      :}
  | lista_argumentos:la
      {:
        RESULT = la;
      :}
  ;

lista_argumentos ::=
    expresion:exp
      {:
        RESULT = exp;
      :}
  | lista_argumentos:la COMA expresion:exp
      {:
        RESULT = (String)la + ", " + exp;
      :}
  ;

/* Fin del parser.cup */
