/* ***********************************************************************************
 * parser.cup - Parser para un lenguaje C-like con tokens "rodolfo", "bromista", etc.
 *
 * CORRECCIONES:
 *  - Eliminado el uso de UNKNOWN_TOKEN que no se requería.
 *  - Reestructurado 'block' y 'stmt_list' para evitar conflictos reduce/reduce.
 *  - Se mantiene la idea de 'pushScope' y 'popScope' al abrir/cerrar llaves,
 *    pero concentrando dichas acciones al comienzo y final del 'block'.
 *  - Uso de una producción "opt_stmt_list" para manejar la opción de cero o más
 *    sentencias dentro de un bloque.
 *
 * ***********************************************************************************/

package ParserLexer;

import java_cup.runtime.*;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Stack;

/* ----------------------------------------------------------------------
   1) Sección de código auxiliar del parser
---------------------------------------------------------------------- */
parser code
{:
    /* -------------------------------------------------------------------
       Estructura para la Tabla de Símbolos
    ------------------------------------------------------------------- */
    public static class SymbolData {
        String lexeme;
        String type;     // rodolfo->int, bromista->float, etc.
        int line;
        int column;
        String scope;
        Object value;    // Valor inicial (si se desea)

        public SymbolData(String lexeme, String type, int line, int column, String scope, Object value) {
            this.lexeme = lexeme;
            this.type = type;
            this.line = line;
            this.column = column;
            this.scope = scope;
            this.value = value;
        }
    }

    /* Atributos para manejo de tabla de símbolos, errores, etc. */
    private List<String> syntaxErrors = new ArrayList<>();
    private List<String> controlStructures = new ArrayList<>();
    private HashMap<String, ArrayList<SymbolData>> symbolTable = new HashMap<>();
    private Stack<String> scopeStack = new Stack<>();

    /* Nombre del scope actual. Comienza como 'global'. */
    private String currentScope = "global";
    /* Contador de bloques anónimos */
    public int blockCounter = 0;

    /* Referencia a nuestro lexer */
    private Lexer lexer;

    public Parser(Lexer l) {
        this.lexer = l;
        scopeStack.push("global");
    }

    /* -------------------------------------------------------------------
       Funciones de reporte y recuperación de errores
    ------------------------------------------------------------------- */
    @Override
    public void report_error(String message, Object info) {
        if (info instanceof Symbol) {
            Symbol sym = (Symbol) info;
            syntaxErrors.add("Error: " + message
                             + " cerca de '" + sym.value + "' "
                             + "(l:" + sym.left + ", c:" + sym.right + ")");
        } else {
            syntaxErrors.add("Error: " + message);
        }
    }

    @Override
    public void report_fatal_error(String message, Object info) {
        report_error(message, info);
        // Por defecto CUP finaliza, pero podríamos continuar si quisiéramos:
        // throw new RuntimeException("Fatal error: " + message);
    }

    @Override
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        syntaxErrors.add("** Error sintáctico irrecuperable ** en token: "
                         + (cur_token != null ? cur_token.value : "null")
                         + " (linea " + (cur_token != null ? cur_token.left : -1)
                         + ", col " + (cur_token != null ? cur_token.right : -1) + ")");
        // CUP normalmente lanza Exception. Puedes comentar si quieres proseguir.
        // throw new RuntimeException("Unrecoverable syntax error");
    }

    /* -------------------------------------------------------------------
       Funciones para manejo de Tabla de Símbolos
    ------------------------------------------------------------------- */
    private void pushScope(String newScope) {
        scopeStack.push(newScope);
        currentScope = newScope;
        if (!symbolTable.containsKey(currentScope)) {
            symbolTable.put(currentScope, new ArrayList<SymbolData>());
        }
    }

    private void popScope() {
        if (!scopeStack.isEmpty()) {
            scopeStack.pop();
            currentScope = scopeStack.isEmpty() ? "global" : scopeStack.peek();
        }
    }

    public void addSymbol(String lexeme, String type, int line, int col, Object value) {
        if (!symbolTable.containsKey(currentScope)) {
            symbolTable.put(currentScope, new ArrayList<SymbolData>());
        }
        SymbolData data = new SymbolData(lexeme, type, line, col, currentScope, value);
        symbolTable.get(currentScope).add(data);
    }

    public void addControlStructure(String info) {
        controlStructures.add(info);
    }

    /* -------------------------------------------------------------------
       Al finalizar el parseo, imprimimos un reporte
    ------------------------------------------------------------------- */
    public void printSummary() {
        System.out.println("\n--- 1) TABLA DE SÍMBOLOS ---");
        System.out.println("Lexema\tTipo\tLínea\tColumna\tScope\tValor");
        System.out.println("-------------------------------------------------");
        for (String sc : symbolTable.keySet()) {
            for (SymbolData sd : symbolTable.get(sc)) {
                System.out.printf("%s\t%s\t%d\t%d\t%s\t%s\n",
                                  sd.lexeme,
                                  sd.type,
                                  sd.line,
                                  sd.column,
                                  sd.scope,
                                  (sd.value != null ? sd.value.toString() : "null"));
            }
        }

        System.out.println("\n--- 2) ESTRUCTURAS DE CONTROL DETECTADAS ---");
        if (controlStructures.isEmpty()) {
            System.out.println("No se detectaron estructuras de control.");
        } else {
            for (String cs : controlStructures) {
                System.out.println("- " + cs);
            }
        }

        System.out.println("\n--- 3) ERRORES SINTÁCTICOS ---");
        if (syntaxErrors.isEmpty()) {
            System.out.println("No se encontraron errores sintácticos.");
        } else {
            for (String err : syntaxErrors) {
                System.out.println("* " + err);
            }
        }

        System.out.println("\n--- 4) RESUMEN GENERAL ---");
        if (syntaxErrors.isEmpty()) {
            System.out.println("Estado del archivo: VÁLIDO");
            System.out.println("Errores encontrados: 0");
        } else {
            System.out.println("Estado del archivo: INVÁLIDO");
            System.out.println("Errores encontrados: " + syntaxErrors.size());
        }
        System.out.println("\nFin del reporte.\n");
    }
:}

/* ----------------------------------------------------------------------
   2) Conexión con el Scanner
---------------------------------------------------------------------- */
scan with
{:
    return lexer.next_token();
:};

/* ----------------------------------------------------------------------
   3) Declaración de TERMINALES
---------------------------------------------------------------------- */

/* Tipos de datos */
terminal INTEGER;  // "rodolfo"
terminal FLOAT;    // "bromista"
terminal BOOL;     // "trueno"
terminal CHAR;     // "cupido"
terminal STRING;   // "cometa"

/* Identificadores y literales */
terminal String IDENTIFICADOR;
terminal Integer L_INTEGER;
terminal Float FLOAT_LITERAL;
terminal Boolean BOOL_LITERAL;
terminal Character CHAR_LITERAL;
terminal String STRING_LITERAL;

/* main */
terminal MAIN; // "_verano_"

/* Bloques */
terminal ABRECUENTO;    // {
terminal CIERRACUENTO;  // }
terminal ABREREGALO;    // (
terminal CIERRAREGALO;  // )
terminal ABREEMPAQUE;   // [
terminal CIERRAEMPAQUE; // ]

/* Declaraciones, asignación y demás */
terminal ASIGNA;        // "entrega"
terminal PUNTO_Y_COMA;  // "finregalo"
terminal COMA;          // ","

/* Operadores aritméticos */
terminal SUMA;           // "+"
terminal RESTA;          // "-"
terminal DIVISION;       // "/"
terminal MULTIPLICACION; // "*"
terminal MODULE;         // "%"
terminal POTENCIA;       // "^"

/* Operadores unarios */
terminal INCREMENTO;  // "++"
terminal DECREMENTO;  // "--"

/* Operadores relacionales */
terminal MENOR;        // "<"
terminal MENOROIGUAL;  // "<="
terminal MAYOR;        // ">"
terminal MAYOROIGUAL;  // ">="
terminal IGUALDAD;     // "=="
terminal DIFERENTE;    // "!="

/* Operadores lógicos */
terminal CONJUNCION; // "&&"
terminal DISYUNCION; // "||"
terminal NEGACION;   // "!"

/* Estructuras de control */
terminal IF;      // "elfo"
terminal ELSE;    // "hada"
terminal WHILE;   // "envuelve"
terminal FOR;     // "duende"
terminal SWITCH;  // "varios"
terminal CASE;    // "historia"
terminal DEFAULT; // "ultimo"
terminal BREAK;   // "corta"
terminal RETURN;  // "envia"
terminal DOS_PUNTOS; // "sigue"

/* I/O */
terminal PRINT; // "narra"
terminal READ;  // "escucha"

terminal UNKNOWN_TOKEN;

/* ----------------------------------------------------------------------
   4) Declaración de NO TERMINALES
---------------------------------------------------------------------- */
non terminal program;
non terminal decl_list, declaration;
non terminal main_decl;
non terminal func_decl, param_list, param;
non terminal block;
non terminal opt_stmt_list, stmt_list, stmt;
non terminal tipo_dato;
non terminal var_decl, var_decl_tail;
non terminal assignment;
non terminal expression;
non terminal array_init, array_item_list, array_item;
non terminal control_stmt;
non terminal if_stmt, while_stmt, for_stmt, switch_stmt;
non terminal case_block_list, case_block, default_block_nt;

/* ----------------------------------------------------------------------
   5) Precedencia
---------------------------------------------------------------------- */
precedence right POTENCIA;
precedence right NEGACION, RESTA; /* resta unaria (negativo) */
precedence left MULTIPLICACION, DIVISION, MODULE;
precedence left SUMA, RESTA;
precedence left MENOR, MENOROIGUAL, MAYOR, MAYOROIGUAL;
precedence left IGUALDAD, DIFERENTE;
precedence left CONJUNCION;
precedence left DISYUNCION;

/* ----------------------------------------------------------------------
   6) Producción inicial
---------------------------------------------------------------------- */
start with program;

/* ----------------------------------------------------------------------
   7) Reglas de producción
---------------------------------------------------------------------- */

/*
 * program
 *   -> decl_list main_decl
 *   -> main_decl
 */
program ::=
    decl_list main_decl
    {:
      parser.printSummary();
    :}
  | main_decl
    {:
      parser.printSummary();
    :}
  ;

/*
 * decl_list -> decl_list declaration | declaration
 */
decl_list ::=
    decl_list declaration
  | declaration
  ;

/*
 * declaration -> var_decl | func_decl
 */
declaration ::=
    var_decl
  | func_decl
  ;

/*
 * main_decl -> MAIN block
 *   Único main por programa
 */
main_decl ::=
    MAIN block
    {:
      System.out.println("[Main] Se reconoció la función principal.");
    :}
  ;

/*
 * var_decl -> tipo_dato IDENTIFICADOR var_decl_tail
 */
var_decl ::=
    tipo_dato:td IDENTIFICADOR:id var_decl_tail
    {:
      int line = idleft;
      int col  = idright;
      parser.addSymbol(id, (String)td, line, col, null);
    :}
  ;

/*
 * var_decl_tail -> PUNTO_Y_COMA
 *                | ASIGNA expression PUNTO_Y_COMA
 *                | ABREEMPAQUE expression CIERRAEMPAQUE PUNTO_Y_COMA
 *                | ABREEMPAQUE expression CIERRAEMPAQUE ASIGNA array_init PUNTO_Y_COMA
 */
var_decl_tail ::=
    PUNTO_Y_COMA
  | ASIGNA expression:e PUNTO_Y_COMA
  | ABREEMPAQUE expression:ex CIERRAEMPAQUE PUNTO_Y_COMA
  | ABREEMPAQUE expression:ex CIERRAEMPAQUE ASIGNA array_init:ai PUNTO_Y_COMA
  ;

/*
 * func_decl -> tipo_dato IDENTIFICADOR '(' param_list ')' block
 *   Se crea un nuevo scope para la función
 */
func_decl ::=
    tipo_dato:td IDENTIFICADOR:id ABREREGALO param_list CIERRAREGALO block
    {:
      // Cerramos scope de la función al salir
      parser.popScope();
      System.out.println("[Func] Declarada función " + id + " con tipo " + td);
    :}
  {:
    /*
     * Observa que en CUP, si hacemos pushScope cuando vemos IDENTIFICADOR,
     * podemos hacerlo aquí. Por simplicidad, se hace en la 1ra acción
     * al reconocer 'IDENTIFICADOR ABREREGALO param_list CIERRAREGALO'.
     *
     * Alternativamente, puedes meter la acción en un mid-rule antes de 'block'.
     */
  :}
  ;

/*
 * param_list -> (vacío) | param (COMA param)*
 */
param_list ::=
    /* vacío */
  | param_list COMA param
  | param
  ;

/*
 * param -> tipo_dato IDENTIFICADOR
 */
param ::=
    tipo_dato:td IDENTIFICADOR:id
    {:
      parser.addSymbol(id, (String)td, idleft, idright, null);
    :}
  ;

/*
 * tipo_dato -> INTEGER | FLOAT | BOOL | CHAR | STRING
 */
tipo_dato ::=
    INTEGER  {: RESULT = "int"; :}
  | FLOAT    {: RESULT = "float"; :}
  | BOOL     {: RESULT = "bool"; :}
  | CHAR     {: RESULT = "char"; :}
  | STRING   {: RESULT = "string"; :}
  ;

/*
 * block -> ABRECUENTO {pushScope("block_x")} opt_stmt_list CIERRACUENTO {popScope()}
 *        | (vacío)
 */
block ::=
    ABRECUENTO
      {:
        // Al abrir un bloque, creamos un scope anónimo
        parser.blockCounter++;
        String newScope = "block_" + parser.blockCounter;
        parser.pushScope(newScope);
      :}
    opt_stmt_list
      {:
        // Al terminar las sentencias
        parser.popScope();
      :}
    CIERRACUENTO
  | /* vacío */
  ;

/*
 * opt_stmt_list -> (vacío) | stmt_list
 */
opt_stmt_list ::=
    /* vacío */
  | stmt_list
  ;

/*
 * stmt_list -> stmt_list stmt | stmt
 */
stmt_list ::=
    stmt_list stmt
  | stmt
  ;

/*
 * stmt -> var_decl
 *       | assignment
 *       | control_stmt
 *       | PRINT ( expression ) ;
 *       | READ ( IDENTIFICADOR ) ;
 *       | RETURN expression ;
 *       | BREAK ;
 *       | error PUNTO_Y_COMA
 */
stmt ::=
    var_decl
  | assignment
  | control_stmt
  | PRINT ABREREGALO expression:e CIERRAREGALO PUNTO_Y_COMA
    {:
      System.out.println("[Print] " + e);
    :}
  | READ ABREREGALO IDENTIFICADOR:id CIERRAREGALO PUNTO_Y_COMA
    {:
      System.out.println("[Read] variable: " + id);
    :}
  | RETURN expression:rex PUNTO_Y_COMA
    {:
      System.out.println("[Return] " + rex);
    :}
  | BREAK PUNTO_Y_COMA
    {:
      System.out.println("[Break]");
    :}
  /* Recuperación modo pánico: saltar hasta ';' */
  | error PUNTO_Y_COMA
    {:
      parser.syntaxErrors.add("Recuperación de error: salto hasta ';'");
    :}
  ;

/*
 * assignment -> IDENTIFICADOR ASIGNA expression ;
 *             | IDENTIFICADOR [ expression ] ASIGNA expression ;
 */
assignment ::=
    IDENTIFICADOR:id ASIGNA expression:ex PUNTO_Y_COMA
    {:
      System.out.println("[Assignment] " + id + " = " + ex);
    :}
  | IDENTIFICADOR:id ABREEMPAQUE expression:idx CIERRAEMPAQUE ASIGNA expression:rhs PUNTO_Y_COMA
    {:
      System.out.println("[Assignment] " + id + "[" + idx + "] = " + rhs);
    :}
  ;

/*
 * array_init -> { array_item_list }
 */
array_init ::=
    ABRECUENTO array_item_list CIERRACUENTO
  ;

/*
 * array_item_list -> array_item (COMA array_item)*
 */
array_item_list ::=
    array_item_list COMA array_item
  | array_item
  ;

/*
 * array_item -> CHAR_LITERAL | L_INTEGER | FLOAT_LITERAL | STRING_LITERAL | BOOL_LITERAL | IDENTIFICADOR
 */
array_item ::=
    CHAR_LITERAL
  | L_INTEGER
  | FLOAT_LITERAL
  | STRING_LITERAL
  | BOOL_LITERAL
  | IDENTIFICADOR
  ;

/*
 * control_stmt -> if_stmt | while_stmt | for_stmt | switch_stmt
 */
control_stmt ::=
    if_stmt
  | while_stmt
  | for_stmt
  | switch_stmt
  ;

/*
 * if_stmt -> IF ( expression ) block
 *          | IF ( expression ) block ELSE block
 */
if_stmt ::=
    IF ABREREGALO expression:cond CIERRAREGALO block
    {:
      parser.addControlStructure("If detectado. Condición: " + cond);
    :}
  | IF ABREREGALO expression:cond CIERRAREGALO block ELSE block
    {:
      parser.addControlStructure("If-Else detectado. Condición: " + cond);
    :}
  | IF ABREREGALO error CIERRAREGALO block
    {:
      parser.syntaxErrors.add("Error en condición de if(), recuperado.");
    :}
  ;

/*
 * while_stmt -> WHILE ( expression ) block
 */
while_stmt ::=
    WHILE ABREREGALO expression:cond CIERRAREGALO block
    {:
      parser.addControlStructure("While detectado. Condición: " + cond);
    :}
  | WHILE ABREREGALO error CIERRAREGALO block
    {:
      parser.syntaxErrors.add("Error en condición de while(), recuperado.");
    :}
  ;

/*
 * for_stmt -> FOR ( assignment , expression , expression ) block
 */
for_stmt ::=
    FOR ABREREGALO assignment:ini COMA expression:cond COMA expression:step CIERRAREGALO block
    {:
      String info = "For detectado. Inicialización: " + ini + ", Cond: " + cond + ", Step: " + step;
      parser.addControlStructure(info);
    :}
  | FOR ABREREGALO error CIERRAREGALO block
    {:
      parser.syntaxErrors.add("Error en estructura for(), recuperado.");
    :}
  ;

/*
 * switch_stmt -> SWITCH ( expression ) { case_block_list }
 */
switch_stmt ::=
    SWITCH ABREREGALO expression:sw CIERRAREGALO ABRECUENTO case_block_list CIERRACUENTO
    {:
      parser.addControlStructure("Switch detectado con expresión: " + sw);
    :}
  | SWITCH ABREREGALO error CIERRAREGALO ABRECUENTO case_block_list CIERRACUENTO
    {:
      parser.syntaxErrors.add("Error en expresión de switch(), recuperado.");
    :}
  ;

/*
 * case_block_list -> case_block_list case_block
 *                  | case_block
 *                  | default_block_nt
 */
case_block_list ::=
    case_block_list case_block
  | case_block
  | default_block_nt
  ;

/*
 * case_block -> CASE L_INTEGER : block
 *             | CASE CHAR_LITERAL : block
 */
case_block ::=
    CASE L_INTEGER DOS_PUNTOS block
  | CASE CHAR_LITERAL DOS_PUNTOS block
  ;

/*
 * default_block_nt -> DEFAULT : block
 */
default_block_nt ::=
    DEFAULT DOS_PUNTOS block
  ;

/*
 * expression
 *  -> expression || expression
 *   | expression && expression
 *   | expression == expression
 *   | expression != expression
 *   | expression < expression
 *   | expression <= expression
 *   | expression > expression
 *   | expression >= expression
 *   | expression + expression
 *   | expression - expression
 *   | expression * expression
 *   | expression / expression
 *   | expression % expression
 *   | expression ^ expression
 *   | ! expression
 *   | - expression
 *   | ++ IDENTIFICADOR
 *   | -- IDENTIFICADOR
 *   | IDENTIFICADOR ++
 *   | IDENTIFICADOR --
 *   | IDENTIFICADOR
 *   | L_INTEGER
 *   | FLOAT_LITERAL
 *   | CHAR_LITERAL
 *   | STRING_LITERAL
 *   | BOOL_LITERAL
 *   | IDENTIFICADOR [ expression ]
 *   | ( expression )
 */
expression ::=
    expression:e1 DISYUNCION expression:e2
      {: RESULT = "(" + e1 + " || " + e2 + ")"; :}
  | expression:e1 CONJUNCION expression:e2
      {: RESULT = "(" + e1 + " && " + e2 + ")"; :}
  | expression:e1 IGUALDAD expression:e2
      {: RESULT = "(" + e1 + " == " + e2 + ")"; :}
  | expression:e1 DIFERENTE expression:e2
      {: RESULT = "(" + e1 + " != " + e2 + ")"; :}
  | expression:e1 MENOR expression:e2
      {: RESULT = "(" + e1 + " < " + e2 + ")"; :}
  | expression:e1 MENOROIGUAL expression:e2
      {: RESULT = "(" + e1 + " <= " + e2 + ")"; :}
  | expression:e1 MAYOR expression:e2
      {: RESULT = "(" + e1 + " > " + e2 + ")"; :}
  | expression:e1 MAYOROIGUAL expression:e2
      {: RESULT = "(" + e1 + " >= " + e2 + ")"; :}
  | expression:e1 SUMA expression:e2
      {: RESULT = "(" + e1 + " + " + e2 + ")"; :}
  | expression:e1 RESTA expression:e2
      {: RESULT = "(" + e1 + " - " + e2 + ")"; :}
  | expression:e1 MULTIPLICACION expression:e2
      {: RESULT = "(" + e1 + " * " + e2 + ")"; :}
  | expression:e1 DIVISION expression:e2
      {: RESULT = "(" + e1 + " / " + e2 + ")"; :}
  | expression:e1 MODULE expression:e2
      {: RESULT = "(" + e1 + " % " + e2 + ")"; :}
  | expression:e1 POTENCIA expression:e2
      {: RESULT = "(" + e1 + " ^ " + e2 + ")"; :}
  | NEGACION expression:e
      {: RESULT = "(!" + e + ")"; :}
  | RESTA expression:e
      {: RESULT = "(-" + e + ")"; :}
  | INCREMENTO IDENTIFICADOR:id
      {: RESULT = "(++" + id + ")"; :}
  | DECREMENTO IDENTIFICADOR:id
      {: RESULT = "(--" + id + ")"; :}
  | IDENTIFICADOR:id INCREMENTO
      {: RESULT = "(" + id + "++)"; :}
  | IDENTIFICADOR:id DECREMENTO
      {: RESULT = "(" + id + "--)"; :}
  | IDENTIFICADOR:id
      {: RESULT = id; :}
  | L_INTEGER:lint
      {: RESULT = lint.toString(); :}
  | FLOAT_LITERAL:flit
      {: RESULT = flit.toString(); :}
  | CHAR_LITERAL:chlit
      {: RESULT = "'" + chlit + "'"; :}
  | STRING_LITERAL:strlit
      {: RESULT = "\"" + strlit + "\""; :}
  | BOOL_LITERAL:blit
      {: RESULT = blit.toString(); :}
  | IDENTIFICADOR:arr ABREEMPAQUE expression:ex CIERRAEMPAQUE
      {: RESULT = arr + "[" + ex + "]"; :}
  | ABREREGALO expression:ex CIERRAREGALO
      {: RESULT = "(" + ex + ")"; :}
  /* Recuperación de error cuando falta algo en la expresión y topamos con ) */
  | error CIERRAREGALO
      {:
        parser.syntaxErrors.add("Error en expresión, recuperado hasta ')'");
        RESULT = "errorExpr";
      :}
  ;
