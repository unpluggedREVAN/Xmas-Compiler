/* ============================================================================
   parser.cup - Versión completa y final para Xmas-Compiler
   (Soporta arreglos, funciones, declaraciones globales, navideños tokens, etc.)
============================================================================ */
package ParserLexer;
import java_cup.runtime.*;

/* ----------------------------------------------------------------------
   1) Sección de código del parser
---------------------------------------------------------------------- */
parser code {:
    // declaración del scanner
    private Lexer s;
    public Parser(Lexer s) { this.s = s; } // constructor

    public void syntax_error(Symbol s) { // manejo de errores - es solo de prueba por ahora
        System.err.println("Error de sintaxis en línea " + (s.left + 1) + ", columna " + (s.right + 1));
        System.err.println("Token inesperado: " + sym.terminalNames[s.sym]);
    }
:}

/* ----------------------------------------------------------------------
   2) Conexión con el scanner
---------------------------------------------------------------------- */
scan with {:
    return s.next_token();
:};

/* ----------------------------------------------------------------------
   3) Declaración de TERMINALES
   (Mapeados a los lexemas navideños según tu lexer.jflex)
---------------------------------------------------------------------- */
terminal IDENTIFICADOR;
terminal INTEGER, FLOAT, BOOL, STRING, CHAR;
terminal L_INTEGER, FLOAT_LITERAL, BOOL_LITERAL, CHAR_LITERAL, STRING_LITERAL;
terminal ASIGNA;  // "entrega"
terminal SUMA, RESTA, DIVISION, MULTIPLICACION, MODULE, POTENCIA; // navidad, intercambio, reyes, etc.
terminal INCREMENTO, DECREMENTO; // quien, grinch
terminal MENOR, MENOROIGUAL, MAYOR, MAYOROIGUAL, IGUALDAD, DIFERENTE; // snowball, evergreen, ...
terminal CONJUNCION, DISYUNCION, NEGACION; // melchor, gaspar, baltazar
terminal IF, ELSE, WHILE, FOR, SWITCH, CASE, DEFAULT, BREAK, RETURN, DOS_PUNTOS;
// (elfo, hada, envuelve, duende, varios, historia, ultimo, corta, envia, sigue)
terminal PRINT, READ, MAIN; // narra, escucha, _verano_
terminal ABRECUENTO, CIERRACUENTO, ABREREGALO, CIERRAREGALO, ABREEMPAQUE, CIERRAEMPAQUE;
terminal PUNTO_Y_COMA, COMA, UNKNOWN_TOKEN;

/* ----------------------------------------------------------------------
   4) Declaración de NO TERMINALES
---------------------------------------------------------------------- */
non terminal programa, declaracionesGlobales, globalDeclaracion, bloque, lista_sentencias, sentencia;
non terminal declaracion, declaracion_aux, asignacion, tipo_dato;
non terminal control_estructuras, if_estructura, while_estructura, for_estructura, switch_estructura;
non terminal case_blocks, case_block, default_block;
non terminal funcion, parametros, lista_parametros, param_dec;
non terminal expresion;
non terminal e_or, e_and, e_cmp, e_cmp_rest, e_cmp_op;
non terminal e_add, e_add_rest;
non terminal e_mul, e_mul_rest;
non terminal e_pow, e_pow_rest;
non terminal e_unario, e_primario;
non terminal literal;

// Operadores con precedencia y asociación
precedence right POTENCIA;                     // ^ es asociativo por la derecha
precedence right NEGACION, RESTA;              // Unarios: !, -
precedence left MULTIPLICACION, DIVISION, MODULE;  // *, /, %
precedence left SUMA, RESTA;                   // +, -
precedence left MENOR, MENOROIGUAL, MAYOR, MAYOROIGUAL; // <, <=, >, >=
precedence left IGUALDAD, DIFERENTE;           // ==, !=
precedence left CONJUNCION;                    // &&
precedence left DISYUNCION;                    // ||

/* ----------------------------------------------------------------------
   5) Producción inicial
---------------------------------------------------------------------- */
start with programa;

/* ----------------------------------------------------------------------
   6) Reglas de Producción
---------------------------------------------------------------------- */

/* ----------------------------------------------------------------------
   A) Estructura General del Programa
   - Pueden existir declaraciones globales (variables y funciones),
     luego la ejecución inicia en MAIN (=_verano_), con un bloque.
---------------------------------------------------------------------- */
programa ::=
    declaracionesGlobales MAIN bloque
            {: System.out.println("Regla 'programa' ejecutada."); :}
  | MAIN bloque
            {: System.out.println("Regla 'programa' ejecutada."); :}
  ;

/* declaracionesGlobales: 1+ globalDeclaracion (variables o funciones) */
declaracionesGlobales ::=
    globalDeclaracion declaracionesGlobales
  | globalDeclaracion
  ;

/* globalDeclaracion puede ser "declaracion" o "funcion" */
globalDeclaracion ::=
    declaracion
  | funcion
  ;

/* Un bloque { lista_sentencias } o vacío */
bloque ::=
    ABRECUENTO lista_sentencias CIERRACUENTO
               {: System.out.println("Regla 'bloque' ejecutada."); :}
  | /* epsilon */
  ;

/* Lista de sentencias (1 o más) */
lista_sentencias ::=
    lista_sentencias sentencia
               {: System.out.println("Regla 'lista_sentencias' procesando lista."); :}
  | sentencia
               {: System.out.println("Regla 'lista_sentencias' procesando sentencia."); :}
  ;

/* ----------------------------------------------------------------------
   B) Sentencia
---------------------------------------------------------------------- */
sentencia ::=
    declaracion
               {: System.out.println("Se fue por declaración"); :}
  | asignacion
               {: System.out.println("Regla 'sentencia' ejecutó 'asignacion'."); :}
  | control_estructuras
               {: System.out.println("Se fue por control_estructuras"); :}
  | PRINT ABREREGALO expresion CIERRAREGALO PUNTO_Y_COMA
               {: System.out.println("Se fue por PRINT ABREREGALO expresion CIERRAREGALO PUNTO_Y_COMA"); :}
  | READ ABREREGALO IDENTIFICADOR CIERRAREGALO PUNTO_Y_COMA
               {: System.out.println("Se fue por READ ABREREGALO IDENTIFICADOR CIERRAREGALO PUNTO_Y_COMA"); :}
  | RETURN expresion PUNTO_Y_COMA
               {: System.out.println("Se fue por RETURN expresion PUNTO_Y_COMA"); :}
  | BREAK PUNTO_Y_COMA
               {: System.out.println("Se fue por BREAK PUNTO_Y_COMA"); :}
  ;

/* ----------------------------------------------------------------------
   C) Declaraciones (Variables y Arreglos Unidimensionales)
   - Solo rodolfo (int) o cupido (char) pueden crear arreglos,
     pero se deja la verificación semántica para la siguiente fase
     (o se podría forzar con una subregla).
---------------------------------------------------------------------- */

declaracion ::=
    tipo_dato:t IDENTIFICADOR:id declaracion_aux:aux
        {:
            System.out.println("Declaración detectada:");
            System.out.println("- Tipo de dato: " + t);
            System.out.println("- Variable: " + id.toString());
            System.out.println("- Inicialización: " + (aux != null ? aux : "No inicializada"));
        :}
  ;

/* Auxiliar:
   1) ;
   2) = expresion ;
   3) [ L_INTEGER ] ;
   (Arreglo unidimensional)
   Se podría ampliar para "inicialización con { ... }" si deseas.
*/
declaracion_aux ::=
    PUNTO_Y_COMA
  | ASIGNA expresion PUNTO_Y_COMA
  | ABREEMPAQUE L_INTEGER CIERRAEMPAQUE PUNTO_Y_COMA
  ;

/* tipo_dato: rodolfo (int), bromista (float), trueno (bool), cupido (char), cometa (string) */
tipo_dato ::=
    INTEGER
  | FLOAT
  | BOOL
  | CHAR
  | STRING
  ;

/* ----------------------------------------------------------------------
   D) Asignaciones
   - var = expr;
   - var[expr] = expr;
---------------------------------------------------------------------- */
asignacion ::=
    IDENTIFICADOR:idVar ASIGNA expresion PUNTO_Y_COMA
        {:
            System.out.println("Asignación detectada, variable: " + idVar.toString());
        :}
  | IDENTIFICADOR:idVar ABREEMPAQUE expresion CIERRAEMPAQUE ASIGNA expresion PUNTO_Y_COMA
        {:
            System.out.println("Asignación a arreglo detectada, variable: " + idVar.toString());
        :}
  ;


/* ----------------------------------------------------------------------
   E) Declaración de Funciones
   - Devuelven entero, flotante, char o bool (string si deseas),
     con parámetros y un bloque.
   - El enunciado dice "p. Debe permitir la creación y uso de funciones ...
     separador de parámetros=coma".
---------------------------------------------------------------------- */
funcion ::=
    tipo_dato IDENTIFICADOR ABREREGALO parametros CIERRAREGALO bloque
  ;

/* parametros -> ( tipo_dato ident (, tipo_dato ident )* )? */
parametros ::=
    /* epsilon */
  | lista_parametros
  ;

/* lista_parametros: param_dec (COMA param_dec)* */
lista_parametros ::=
    param_dec
  | lista_parametros COMA param_dec
  ;

/* param_dec -> tipo_dato IDENTIFICADOR */
param_dec ::=
    tipo_dato IDENTIFICADOR
  ;

/* ----------------------------------------------------------------------
   F) Estructuras de Control
   (if, while, for, switch)
---------------------------------------------------------------------- */
control_estructuras ::=
    if_estructura
  | while_estructura
  | for_estructura
  | switch_estructura
  ;

/* if ( expr ) bloque [ else bloque ] */
if_estructura ::=
    IF ABREREGALO expresion CIERRAREGALO bloque
  | IF ABREREGALO expresion CIERRAREGALO bloque ELSE bloque
  ;

/* while ( expr ) bloque */
while_estructura ::=
    WHILE ABREREGALO expresion CIERRAREGALO bloque
  ;

/* FOR con comas, según ejemplo: for ( asignacion , expr , expr ) { ... }
   o la forma normal: for( asig ; expr ; asig )?
   El enunciado no lo define con exactitud.
   Te ofrezco la de comas (coincidiendo con el ejemplo).
*/
for_estructura ::=
    FOR ABREREGALO asignacion COMA expresion COMA expresion CIERRAREGALO bloque
  ;

/* switch( expr ) { case_blocks } */
switch_estructura ::=
    SWITCH ABREREGALO expresion CIERRAREGALO ABRECUENTO case_blocks CIERRACUENTO
  ;

/* case_blocks -> (cases)* [ default ] */
case_blocks ::=
    case_blocks case_block
  | case_block
  | default_block
  ;

/* case_block -> case L_INTEGER:  block
               | case CHAR_LITERAL: block
   (Podrías aceptar int o char, u otros literales)
*/
case_block ::=
    CASE L_INTEGER DOS_PUNTOS bloque
  | CASE CHAR_LITERAL DOS_PUNTOS bloque
  ;

/* default: block */
default_block ::=
    DEFAULT DOS_PUNTOS bloque
  ;

/* ----------------------------------------------------------------------
   G) Expresiones con Precedencia
   - lógicas, relacionales, aritméticas, potencia, unarios, literales...
---------------------------------------------------------------------- */

expresion ::=
      expresion DISYUNCION expresion           // ||
    | expresion CONJUNCION expresion           // &&
    | expresion IGUALDAD expresion             // ==
    | expresion DIFERENTE expresion            // !=
    | expresion MENOR expresion                // <
    | expresion MENOROIGUAL expresion          // <=
    | expresion MAYOR expresion                // >
    | expresion MAYOROIGUAL expresion          // >=
    | expresion SUMA expresion                 // +
    | expresion RESTA expresion                // -
    | expresion MULTIPLICACION expresion       // *
    | expresion DIVISION expresion             // /
    | expresion MODULE expresion               // %
    | expresion POTENCIA expresion             // ^
    | NEGACION expresion                       // Unario: !
    | RESTA expresion                          // Unario: -
    | IDENTIFICADOR
    | L_INTEGER
    | FLOAT_LITERAL
    | CHAR_LITERAL
    | STRING_LITERAL
    | BOOL_LITERAL
    | IDENTIFICADOR ABREEMPAQUE expresion CIERRAEMPAQUE
    | ABREREGALO expresion CIERRAREGALO
    ;

/* ----------------------------------------------------------------------
   H) Literales
---------------------------------------------------------------------- */
literal ::=
    L_INTEGER
  | FLOAT_LITERAL
  | CHAR_LITERAL
  | STRING_LITERAL
  | BOOL_LITERAL
  ;

/* ============================================================================
   Fin del parser.cup
============================================================================ */
