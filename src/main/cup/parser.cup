/* ============================================================================
   parser.cup - Xmas-Compiler (versión limpia + recolección de asignaciones)
============================================================================ */
package ParserLexer;

import java_cup.runtime.*;
import java.util.ArrayList; // Para la lista de asignaciones
import java.util.List;
import ParserLexer.SymbolTableManager.SymbolData;

parser code {:
    // Lista de errores sintácticos
    private List<String> errores = new ArrayList<>();

    // Objeto para manejar tabla de símbolos y análisis semántico:
    private SymbolTableManager manager;
    private Lexer s;

    // NUEVO: Para guardar asignaciones simples (p.e. "assign(x=expr)").
    private List<String> asignacionesRealizadas = new ArrayList<>();

    public Parser(Lexer s) {
        this.s = s;
        this.manager = new SymbolTableManager();
    }

    public SymbolTableManager getSymbolTableManager() {
        return this.manager;
    }

    // Método para que Test.java recoja las asignaciones y las pase al SemanticAnalyzer
    public List<String> getAsignaciones() {
        return this.asignacionesRealizadas;
    }

    @Override
    public void syntax_error(Symbol sym) {
        report_error("Token inesperado", sym);
    }

    @Override
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        errores.add("** Error sintáctico irrecuperable ** en token: "
                    + (cur_token != null ? cur_token.value : "null")
                    + " (línea " + (cur_token != null ? (cur_token.left + 1) : -1)
                    + ", col "   + (cur_token != null ? (cur_token.right + 1) : -1) + ")");
        // No lanzamos excepción, para que el programa no termine abruptamente.
    }

    @Override
    public void report_fatal_error(String message, Object info) {
        report_error(message, info);
    }

    @Override
    public void report_error(String message, Object info) {
        if (info instanceof Symbol) {
            Symbol sym = (Symbol) info;
            String errorMsg = "Error: " + message
                              + " cerca del token '" + sym.value + "' "
                              + "(línea " + (sym.left + 1) + ", col " + (sym.right + 1) + ")";
            errores.add(errorMsg);
            System.err.println(errorMsg);
        } else {
            String errorMsg = "Error: " + message;
            errores.add(errorMsg);
            System.err.println(errorMsg);
        }
    }

    // Método que imprime un reporte final (sintáctico + tabla de símbolos).
    private void imprimirReporteFinal() {
        System.out.println("\n--- ERRORES SINTÁCTICOS ENCONTRADOS ---");
        if (errores.isEmpty()) {
            System.out.println("No se encontraron errores sintácticos.");
        } else {
            for (String err : errores) {
                System.out.println("* " + err);
            }
        }

        manager.imprimirReporte();  // Parte final (tabla de símbolos, etc.)
    }

:}

/* ----------------------------------------------------------------------
   2) scanner
---------------------------------------------------------------------- */
scan with {:
    return s.next_token();
:};

/* ----------------------------------------------------------------------
   3) Declaración de TERMINALES
---------------------------------------------------------------------- */
terminal String IDENTIFICADOR;
terminal INTEGER, FLOAT, BOOL, STRING, CHAR;
terminal L_INTEGER, FLOAT_LITERAL, BOOL_LITERAL, CHAR_LITERAL, STRING_LITERAL;
terminal ASIGNA;
terminal INCREMENTO, DECREMENTO, UNKNOWN_TOKEN;
terminal SUMA, RESTA, DIVISION, MULTIPLICACION, MODULE, POTENCIA;
terminal MENOR, MENOROIGUAL, MAYOR, MAYOROIGUAL, IGUALDAD, DIFERENTE;
terminal CONJUNCION, DISYUNCION, NEGACION;
terminal IF, ELSE, WHILE, FOR, SWITCH, CASE, DEFAULT, BREAK, RETURN, DOS_PUNTOS;
terminal PRINT, READ, MAIN;
terminal ABRECUENTO, CIERRACUENTO, ABREREGALO, CIERRAREGALO, ABREEMPAQUE, CIERRAEMPAQUE;
terminal PUNTO_Y_COMA, COMA;

/* ----------------------------------------------------------------------
   4) Declaración de NO TERMINALES
---------------------------------------------------------------------- */
non terminal programa, declaracionesGlobales, globalDeclaracion, maindeclaracion;
non terminal bloque, lista_sentencias, sentencia;
non terminal declaracion, declaracion_aux, asignacion, tipo_dato;
non terminal control_estructuras, if_estructura, while_estructura, for_estructura, switch_estructura;
non terminal case_blocks, case_block, default_block;
non terminal funcion, parametros, lista_parametros, param_dec;
non terminal expresion, array_init, array_item, array_item_list;
non terminal customError;
non terminal argumentos, lista_argumentos;

/* ----------------------------------------------------------------------
   5) Precedencia
---------------------------------------------------------------------- */
precedence right POTENCIA;
precedence right NEGACION, RESTA;
precedence left MULTIPLICACION, DIVISION, MODULE;
precedence left SUMA, RESTA;
precedence left MENOR, MENOROIGUAL, MAYOR, MAYOROIGUAL;
precedence left IGUALDAD, DIFERENTE;
precedence left CONJUNCION;
precedence left DISYUNCION;

/* ----------------------------------------------------------------------
   6) Producción inicial
---------------------------------------------------------------------- */
start with programa;

/* ----------------------------------------------------------------------
   7) Reglas de Producción
---------------------------------------------------------------------- */

/* A) Estructura General del Programa */
programa ::=
    declaracionesGlobales maindeclaracion bloque
       {:
         manager.addDerivation("programa -> declaracionesGlobales maindeclaracion bloque");
         System.out.println("Regla 'programa' con declaracionesGlobales + MAIN");
         imprimirReporteFinal();
       :}
  | maindeclaracion bloque
       {:
         manager.addDerivation("programa -> maindeclaracion bloque");
         System.out.println("Regla 'programa' con sólo MAIN");
         imprimirReporteFinal();
       :}
  ;

/* Main */
maindeclaracion ::=
    MAIN
      {:
        manager.addDerivation("maindeclaracion -> MAIN");
      :}
  | MAIN ABREREGALO CIERRAREGALO
      {:
        manager.addDerivation("maindeclaracion -> MAIN ( )");
      :}
  | tipo_dato MAIN
      {:
        manager.addDerivation("maindeclaracion -> tipo_dato MAIN");
      :}
  | tipo_dato MAIN ABREREGALO CIERRAREGALO
      {:
        manager.addDerivation("maindeclaracion -> tipo_dato MAIN ( )");
      :}
  ;

/* declaracionesGlobales -> (globalDeclaracion)+ */
declaracionesGlobales ::=
    declaracionesGlobales globalDeclaracion
      {:
        manager.addDerivation("declaracionesGlobales -> declaracionesGlobales globalDeclaracion");
      :}
  | globalDeclaracion
      {:
        manager.addDerivation("declaracionesGlobales -> globalDeclaracion");
      :}
  ;

globalDeclaracion ::=
    declaracion
      {:
        manager.addDerivation("globalDeclaracion -> declaracion");
      :}
  | funcion
      {:
        manager.addDerivation("globalDeclaracion -> funcion");
      :}
  ;

/* B) Bloque */
bloque ::=
    ABRECUENTO lista_sentencias CIERRACUENTO
      {:
        manager.addDerivation("bloque -> { lista_sentencias }");
        System.out.println("Regla 'bloque' ejecutada.");
      :}
  | /* epsilon */
      {:
        manager.addDerivation("bloque -> /* epsilon */");
      :}
  ;

/* lista_sentencias */
lista_sentencias ::=
    lista_sentencias sentencia
      {:
        manager.addDerivation("lista_sentencias -> lista_sentencias sentencia");
      :}
  | sentencia
      {:
        manager.addDerivation("lista_sentencias -> sentencia");
      :}
  ;

/* ----------------------------------------------------------------------
   C) Sentencia
---------------------------------------------------------------------- */
sentencia ::=
    declaracion
      {:
        manager.addDerivation("sentencia -> declaracion");
      :}
  | asignacion
      {:
        manager.addDerivation("sentencia -> asignacion");
      :}
  | control_estructuras
      {:
        manager.addDerivation("sentencia -> control_estructuras");
      :}
  | PRINT ABREREGALO expresion:e CIERRAREGALO PUNTO_Y_COMA
      {:
         manager.addDerivation("sentencia -> PRINT ( expresion ) ;");
         System.out.println("Imprimiendo la expresión: " + e);
      :}
  | READ ABREREGALO IDENTIFICADOR:id CIERRAREGALO PUNTO_Y_COMA
      {:
         manager.addDerivation("sentencia -> READ ( IDENTIFICADOR ) ;");
         System.out.println("Leyendo variable: " + id);
      :}
  | RETURN expresion:ret PUNTO_Y_COMA
      {:
         manager.addDerivation("sentencia -> RETURN expresion ;");
         System.out.println("Return con expr: " + ret);
      :}
  | BREAK PUNTO_Y_COMA
      {:
         manager.addDerivation("sentencia -> BREAK ;");
         System.out.println("Break detectado.");
         manager.addControlStructure("Se detectó un 'break'.");
      :}
  | customError PUNTO_Y_COMA
      {:
         manager.addDerivation("sentencia -> customError ;");
         System.err.println("Recuperado un error en sentencia con customError;");
      :}
  | UNKNOWN_TOKEN:unk
      {:
         manager.addDerivation("sentencia -> UNKNOWN_TOKEN");
         report_error("Sentencia desconocida, token ignorado", unk);
      :}
  ;

customError ::=
    customError error
      {:
        manager.addDerivation("customError -> customError error");
      :}
  | error
      {:
        manager.addDerivation("customError -> error");
      :}
  ;

/* ----------------------------------------------------------------------
   D) Declaraciones
---------------------------------------------------------------------- */
declaracion ::= tipo_dato:td IDENTIFICADOR:myid
    {:
        // Mid-rule action: Establecer lastDeclaredIdentifier y añadir símbolo aquí
        manager.setLastDeclaredIdentifier(myid);

        String t = (String) td;
        System.out.println("Declaración detectada: (tipo=" + t + ", var=" + myid + ")");

        // Guardar la variable con valor inicial null
        int line = myidleft + 1;
        int col  = myidright + 1;
        manager.addSimbolo(manager.getCurrentScope(), myid, line, col, t);
    :}
    declaracion_aux
    {:
        // Código posterior si es necesario
    :}
  ;

declaracion_aux ::=
    PUNTO_Y_COMA
    {:
        manager.addDerivation("declaracion_aux -> ;");
        // No hay asignación, la variable ya existe con valor `null` desde la declaración.
    :}
  | ASIGNA expresion:ex PUNTO_Y_COMA
    {:
        manager.addDerivation("declaracion_aux -> = expresion ;");

        // Recuperamos correctamente la última variable declarada
        String lastId = manager.getLastDeclaredIdentifier();
        SymbolData var = manager.findSymbolRecursive(lastId);

        if (var != null) {
            var.value = ex;  // Ahora la asignación se hace correctamente
            System.out.println("✔ Valor asignado correctamente: " + lastId + " = " + ex);
        } else {
            manager.addSemanticError("Error: Variable '" + lastId + "' no declarada antes de asignación.");
        }
    :}
  | ABREEMPAQUE expresion:idx CIERRAEMPAQUE PUNTO_Y_COMA
    {:
        manager.addDerivation("declaracion_aux -> [ expresion ] ;");

        // Recuperamos correctamente la última variable declarada
        String lastId = manager.getLastDeclaredIdentifier();
        SymbolData var = manager.findSymbolInScope(lastId, manager.getCurrentScope());

        if (var != null) {
            manager.markAsArray(manager.getCurrentScope(), lastId, Integer.parseInt(idx.toString()));
            System.out.println("✔ Array detectado: " + lastId + " con tamaño " + idx);
        } else {
            manager.addSemanticError("Error: Intento de marcar '" + lastId + "' como array sin declaración previa.");
        }
    :}
  | ABREEMPAQUE expresion:idx CIERRAEMPAQUE ASIGNA array_init:ai PUNTO_Y_COMA
    {:
        manager.addDerivation("declaracion_aux -> [ expresion ] = array_init ;");

        // Recuperamos correctamente la última variable declarada
        String lastId = manager.getLastDeclaredIdentifier();
        SymbolData var = manager.findSymbolInScope(lastId, manager.getCurrentScope());

        if (var != null) {
            manager.markAsArray(manager.getCurrentScope(), lastId, Integer.parseInt(idx.toString()));
            var.value = ai;  // Guardamos la inicialización del array
            System.out.println("✔ Array inicializado correctamente: " + lastId + " = " + ai);
        } else {
            manager.addSemanticError("Error: Intento de inicializar '" + lastId + "' como array sin declaración previa.");
        }
    :}
  ;

/* array_init ::= { array_item_list } */
array_init ::=
    ABRECUENTO array_item_list:ail CIERRACUENTO
      {:
        manager.addDerivation("array_init -> { array_item_list }");
        RESULT = "{ " + ail + " }";
      :}
  ;

array_item_list ::=
    array_item:ai
      {:
        manager.addDerivation("array_item_list -> array_item");
        RESULT = ai;
      :}
  | array_item_list:ail COMA array_item:ai
      {:
        manager.addDerivation("array_item_list -> array_item_list , array_item");
        RESULT = (String)ail + ", " + (String)ai;
      :}
  ;

array_item ::=
    CHAR_LITERAL:ch
      {:
        manager.addDerivation("array_item -> CHAR_LITERAL");
        RESULT = "'"+ch+"'";
      :}
  | L_INTEGER:li
      {:
        manager.addDerivation("array_item -> L_INTEGER");
        RESULT = li.toString();
      :}
  | FLOAT_LITERAL:fl
      {:
        manager.addDerivation("array_item -> FLOAT_LITERAL");
        RESULT = fl.toString();
      :}
  | IDENTIFICADOR:id
      {:
        manager.addDerivation("array_item -> IDENTIFICADOR");
        RESULT = id;
      :}
  | STRING_LITERAL:st
      {:
        manager.addDerivation("array_item -> STRING_LITERAL");
        RESULT = "\""+st+"\"";
      :}
  | BOOL_LITERAL:boo
      {:
        manager.addDerivation("array_item -> BOOL_LITERAL");
        RESULT = boo.toString();
      :}
  ;

/* Tipos base */
tipo_dato ::=
    INTEGER
      {:
        manager.addDerivation("tipo_dato -> INTEGER");
        RESULT = "int";
      :}
  | FLOAT
      {:
        manager.addDerivation("tipo_dato -> FLOAT");
        RESULT = "float";
      :}
  | BOOL
      {:
        manager.addDerivation("tipo_dato -> BOOL");
        RESULT = "bool";
      :}
  | CHAR
      {:
        manager.addDerivation("tipo_dato -> CHAR");
        RESULT = "char";
      :}
  | STRING
      {:
        manager.addDerivation("tipo_dato -> STRING");
        RESULT = "string";
      :}
  ;

/* ----------------------------------------------------------------------
   E) Asignaciones
---------------------------------------------------------------------- */
asignacion ::=
    IDENTIFICADOR:idVar ASIGNA expresion:ex PUNTO_Y_COMA
      {:
        manager.addDerivation("asignacion -> IDENTIFICADOR = expresion ;");
        System.out.println("Asignación simple a variable " + idVar + " con expr: " + ex);

        // Buscar la variable en la tabla de símbolos
        SymbolData var = manager.findSymbolRecursive(idVar);
        if (var != null) {
            var.value = ex;  // Guardar el valor en la tabla de símbolos
            System.out.println("Valor actualizado en tabla de símbolos: " + idVar + " = " + ex);
        } else {
            manager.addSemanticError("Error: Asignación a variable no declarada '" + idVar + "'");
        }

        // Guardamos la asignación para el SemanticAnalyzer.
        String asigStr = "assign(" + idVar + "=" + ex + ")";
        asignacionesRealizadas.add(asigStr);
        RESULT = asigStr;
      :}
  | IDENTIFICADOR:idVar ABREEMPAQUE expresion:pos CIERRAEMPAQUE ASIGNA expresion:rhs PUNTO_Y_COMA
      {:
        manager.addDerivation("asignacion -> IDENTIFICADOR [ expresion ] = expresion ;");
        System.out.println("Asignación a arreglo " + idVar + "[" + pos + "] = " + rhs);

        String asigStr = "assignArr(" + idVar + "["+pos+"]="+rhs+")";
        RESULT = asigStr;
        // Si quisieras, podrías almacenar en asignacionesRealizadas si deseas.
      :}
  ;

/* ----------------------------------------------------------------------
   F) declaración de funciones
---------------------------------------------------------------------- */
funcion ::=
    tipo_dato:td IDENTIFICADOR:funId
    {:
        manager.addDerivation("funcion -> tipo_dato IDENTIFICADOR ...");
        // Al reconocer la función, creamos un nuevo scope con la clase manager.
        String t = (String) td;
        int line = funIdleft + 1;
        int col  = funIdright + 1;
        manager.crearScopeFuncion(t, funId, line, col);
    :}
    ABREREGALO parametros:p CIERRAREGALO bloque:b
    {:
       manager.addDerivation("funcion -> ... ( parametros ) bloque");
       String pStr = (String) p;
       if (pStr.isEmpty()) pStr = "0 params";

       String t = (String) td;
       System.out.println("Función declarada: " + funId + ", tipo " + t + ", params: " + pStr);

       manager.popScope();
    :}
  ;

/* parametros -> (lista_parametros)? */
parametros ::=
    /* epsilon */
      {:
        manager.addDerivation("parametros -> /* epsilon */");
        RESULT = "";
      :}
  | lista_parametros:pp
      {:
        manager.addDerivation("parametros -> lista_parametros");
        RESULT = pp;
      :}
  ;

/* lista_parametros -> param_dec (, param_dec)* */
lista_parametros ::=
    param_dec:pd
      {:
        manager.addDerivation("lista_parametros -> param_dec");
        RESULT = pd;
      :}
  | lista_parametros:lp COMA param_dec:pd
      {:
        manager.addDerivation("lista_parametros -> lista_parametros , param_dec");
        RESULT = (String)lp + ", " + (String)pd;
      :}
  ;

/* param_dec -> tipo_dato IDENTIFICADOR */
param_dec ::=
    tipo_dato:td IDENTIFICADOR:pid
      {:
        manager.addDerivation("param_dec -> tipo_dato IDENTIFICADOR");
        String t = (String) td;
        String paramStr = t + " " + pid;
        System.out.println("Parametro: " + paramStr);

        int line = pidleft + 1;
        int col  = pidright + 1;
        manager.addSimbolo(manager.getCurrentScope(), pid, line, col, t);
        // O si quisieras, manager.addParamToCurrentFunction(pid, t);

        RESULT = paramStr;
        // Guardar el parámetro en la función actual
        manager.addParamToCurrentFunction(pid, t);
      :}
  ;

/* ----------------------------------------------------------------------
   G) Estructuras de Control
---------------------------------------------------------------------- */
control_estructuras ::=
    if_estructura
      {:
        manager.addDerivation("control_estructuras -> if_estructura");
      :}
  | while_estructura
      {:
        manager.addDerivation("control_estructuras -> while_estructura");
      :}
  | for_estructura
      {:
        manager.addDerivation("control_estructuras -> for_estructura");
      :}
  | switch_estructura
      {:
        manager.addDerivation("control_estructuras -> switch_estructura");
      :}
  ;

if_estructura ::=
    IF ABREREGALO expresion:cond CIERRAREGALO bloque:b
      {:
        manager.addDerivation("if_estructura -> IF ( expresion ) bloque");
        RESULT = "if("+cond+")"+b;
        manager.addControlStructure("Se detectó un 'if' con cond: " + cond);
      :}
  | IF ABREREGALO expresion:cond CIERRAREGALO bloque:b1 ELSE bloque:b2
      {:
        manager.addDerivation("if_estructura -> IF ( expresion ) bloque ELSE bloque");
        RESULT = "if("+cond+")"+b1+" else "+b2;
        manager.addControlStructure("Se detectó un 'if-else' con cond: " + cond);
      :}
  | IF ABREREGALO error CIERRAREGALO bloque:bl
      {:
        manager.addDerivation("if_estructura -> IF ( error ) bloque");
        report_error("Error en condición de 'if'", "IF");
        RESULT = "ifError"+bl;
      :}
  ;

while_estructura ::=
    WHILE ABREREGALO expresion:cond CIERRAREGALO bloque:bl
      {:
        manager.addDerivation("while_estructura -> WHILE ( expresion ) bloque");
        RESULT = "while("+cond+")"+bl;
        manager.addControlStructure("Se detectó un 'while' con cond: " + cond);
      :}
  | WHILE ABREREGALO error CIERRAREGALO bloque:bl
      {:
        manager.addDerivation("while_estructura -> WHILE ( error ) bloque");
        report_error("Error en condición de 'while'", "WHILE");
        RESULT = "whileError"+bl;
      :}
  ;

for_estructura ::=
    FOR ABREREGALO asignacion:ini COMA expresion:cond COMA expresion:step CIERRAREGALO bloque:bl
      {:
        manager.addDerivation("for_estructura -> FOR ( asignacion , expresion , expresion ) bloque");
        RESULT = "for("+ini+", "+cond+", "+step+")"+bl;
        manager.addControlStructure("Se detectó un 'for' con init=" + ini + ", cond=" + cond + ", step=" + step);
      :}
  | FOR ABREREGALO error CIERRAREGALO bloque:bl
      {:
        manager.addDerivation("for_estructura -> FOR ( error ) bloque");
        report_error("Error en 'for'", "FOR");
        RESULT = "forError"+bl;
      :}
  ;

switch_estructura ::=
    SWITCH ABREREGALO expresion:sw CIERRAREGALO ABRECUENTO case_blocks:cs CIERRACUENTO
      {:
        manager.addDerivation("switch_estructura -> SWITCH ( expresion ) { case_blocks }");
        RESULT = "switch("+sw+") { "+cs+" }";
        manager.addControlStructure("Se detectó un 'switch' con expr: " + sw);
      :}
  | SWITCH ABREREGALO error CIERRAREGALO ABRECUENTO case_blocks:cs CIERRACUENTO
      {:
        manager.addDerivation("switch_estructura -> SWITCH ( error ) { case_blocks }");
        report_error("Error en 'switch'", "SWITCH");
        RESULT = "switchError{ "+cs+" }";
      :}
  ;

case_blocks ::=
    case_blocks:prev case_block:cb
      {:
        manager.addDerivation("case_blocks -> case_blocks case_block");
        RESULT = prev + " " + cb;
      :}
  | case_block:cb
      {:
        manager.addDerivation("case_blocks -> case_block");
        RESULT = cb;
      :}
  | default_block:db
      {:
        manager.addDerivation("case_blocks -> default_block");
        RESULT = db;
      :}
  ;

case_block ::=
    CASE L_INTEGER:li DOS_PUNTOS bloque:bl
      {:
        manager.addDerivation("case_block -> CASE L_INTEGER : bloque");
        RESULT = "case "+li+": "+bl;
      :}
  | CASE CHAR_LITERAL:ch DOS_PUNTOS bloque:bl
      {:
        manager.addDerivation("case_block -> CASE CHAR_LITERAL : bloque");
        RESULT = "case '"+ch+"': "+bl;
      :}
  ;

default_block ::=
    DEFAULT DOS_PUNTOS bloque:bl
      {:
        manager.addDerivation("default_block -> DEFAULT : bloque");
        RESULT = "default: "+bl;
      :}
  ;

/* ----------------------------------------------------------------------
   H) Expresión con precedencia
---------------------------------------------------------------------- */
expresion ::=
    expresion:e1 DISYUNCION expresion:e2
      {:
        manager.addDerivation("expresion -> expresion || expresion");
        RESULT = "("+e1+" || "+e2+")";
      :}
  | expresion:e1 CONJUNCION expresion:e2
      {:
        manager.addDerivation("expresion -> expresion && expresion");
        RESULT = "("+e1+" && "+e2+")";
      :}
  | expresion:e1 IGUALDAD expresion:e2
      {:
        manager.addDerivation("expresion -> expresion == expresion");
        RESULT = "("+e1+" == "+e2+")";
      :}
  | expresion:e1 DIFERENTE expresion:e2
      {:
        manager.addDerivation("expresion -> expresion != expresion");
        RESULT = "("+e1+" != "+e2+")";
      :}
  | expresion:e1 MENOR expresion:e2
      {:
        manager.addDerivation("expresion -> expresion < expresion");
        RESULT = "("+e1+" < "+e2+")";
      :}
  | expresion:e1 MENOROIGUAL expresion:e2
      {:
        manager.addDerivation("expresion -> expresion <= expresion");
        RESULT = "("+e1+" <= "+e2+")";
      :}
  | expresion:e1 MAYOR expresion:e2
      {:
        manager.addDerivation("expresion -> expresion > expresion");
        RESULT = "("+e1+" > "+e2+")";
      :}
  | expresion:e1 MAYOROIGUAL expresion:e2
      {:
        manager.addDerivation("expresion -> expresion >= expresion");
        RESULT = "("+e1+" >= "+e2+")";
      :}
  | expresion:e1 SUMA expresion:e2
      {:
        manager.addDerivation("expresion -> expresion + expresion");
        RESULT = "("+e1+" + "+e2+")";
      :}
  | expresion:e1 RESTA expresion:e2
      {:
        manager.addDerivation("expresion -> expresion - expresion");
        RESULT = "("+e1+" - "+e2+")";
      :}
  | expresion:e1 MULTIPLICACION expresion:e2
      {:
        manager.addDerivation("expresion -> expresion * expresion");
        RESULT = "("+e1+" * "+e2+")";
      :}
  | expresion:e1 DIVISION expresion:e2
      {:
        manager.addDerivation("expresion -> expresion / expresion");
        RESULT = "("+e1+" / "+e2+")";
      :}
  | expresion:e1 MODULE expresion:e2
      {:
        manager.addDerivation("expresion -> expresion % expresion");
        RESULT = "("+e1+" % "+e2+")";
      :}
  | expresion:e1 POTENCIA expresion:e2
      {:
        manager.addDerivation("expresion -> expresion ^ expresion");
        RESULT = "("+e1+" ^ "+e2+")";
      :}
  | NEGACION expresion:e
      {:
        manager.addDerivation("expresion -> ! expresion");
        RESULT = "!"+e;
      :}
  | RESTA expresion:e
      {:
        manager.addDerivation("expresion -> - expresion");
        RESULT = "-"+e;
      :}
  | INCREMENTO IDENTIFICADOR:id
      {:
        manager.addDerivation("expresion -> ++ IDENTIFICADOR");
        RESULT = "++"+id;
      :}
  | DECREMENTO IDENTIFICADOR:id
      {:
        manager.addDerivation("expresion -> -- IDENTIFICADOR");
        RESULT = "--"+id;
      :}
  | IDENTIFICADOR:id INCREMENTO
      {:
        manager.addDerivation("expresion -> IDENTIFICADOR ++");
        RESULT = id+"++";
      :}
  | IDENTIFICADOR:id DECREMENTO
      {:
        manager.addDerivation("expresion -> IDENTIFICADOR --");
        RESULT = id+"--";
      :}
  | IDENTIFICADOR:id ABREREGALO argumentos:args CIERRAREGALO
      {:
        manager.addDerivation("expresion -> IDENTIFICADOR ( argumentos )");
        RESULT = id + "(" + args + ")";
      :}
  | IDENTIFICADOR:id
      {:
        manager.addDerivation("expresion -> IDENTIFICADOR");
        RESULT = id;
      :}
  | L_INTEGER:lint
      {:
        manager.addDerivation("expresion -> L_INTEGER");
        RESULT = lint.toString();
      :}
  | FLOAT_LITERAL:flit
      {:
        manager.addDerivation("expresion -> FLOAT_LITERAL");
        RESULT = flit.toString();
      :}
  | CHAR_LITERAL:chl
      {:
        manager.addDerivation("expresion -> CHAR_LITERAL");
        RESULT = "'"+chl+"'";
      :}
  | STRING_LITERAL:str
      {:
        manager.addDerivation("expresion -> STRING_LITERAL");
        RESULT = "\""+str+"\"";
      :}
  | BOOL_LITERAL:boo
      {:
        manager.addDerivation("expresion -> BOOL_LITERAL");
        RESULT = boo.toString();
      :}
  | IDENTIFICADOR:arr ABREEMPAQUE expresion:ex CIERRAEMPAQUE
      {:
        manager.addDerivation("expresion -> IDENTIFICADOR [ expresion ]");
        RESULT = arr + "["+ex+"]";
      :}
  | ABREREGALO expresion:ex CIERRAREGALO
      {:
        manager.addDerivation("expresion -> ( expresion )");
        RESULT = "("+ex+")";
      :}
  | error CIERRAREGALO
      {:
        manager.addDerivation("expresion -> error )");
        report_error("Error en expresión. Recuperado hasta ')'", "EXP");
        RESULT = "errorExpr";
      :}
  ;

/* lista de argumentos en llamada de función */
argumentos ::=
    /* epsilon: llamada sin argumentos */
      {:
        manager.addDerivation("argumentos -> /* epsilon */");
        RESULT = "";
      :}
  | lista_argumentos:la
      {:
        manager.addDerivation("argumentos -> lista_argumentos");
        RESULT = la;
      :}
  ;

lista_argumentos ::=
    expresion:exp
      {:
        manager.addDerivation("lista_argumentos -> expresion");
        RESULT = exp;
      :}
  | lista_argumentos:la COMA expresion:exp
      {:
        manager.addDerivation("lista_argumentos -> lista_argumentos , expresion");
        RESULT = (String)la + ", " + exp;
      :}
  ;
