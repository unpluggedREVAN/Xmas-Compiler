package ParserLexer;
import java_cup.runtime.*;

/* ----------------------------------------------------------------------
   1) Sección de código del parser
---------------------------------------------------------------------- */
parser code {:
    private Lexer s;
    public Parser(Lexer s) { this.s = s; }

    @Override
    public void syntax_error(Symbol sym) {
        System.err.println("Error de sintaxis en línea "
                           + (sym.left + 1) + ", columna " + (sym.right + 1));
        System.err.println("Token inesperado: " + sym.value);
    }
:}

/* ----------------------------------------------------------------------
   2) Conexión con el scanner
---------------------------------------------------------------------- */
scan with {:
    return s.next_token();
:};

/* ----------------------------------------------------------------------
 Parte de la tabla de símbolos
-----------------------------------------------------------------------*/

action code {:

  /*
  NOTA PABLO
  Aquí es la misma estructura que siguio el profe, el cambio que voy a hacer es a la hora de meter los valores a la tabla
  */

  HashMap<String, ArrayList>> listaTablaSimbolos = new HashMap<String, ArrayList<String>>();
  String hashActual;

      public void imprimirTablaSimbolos() {
        for (String key : listaTablasSimbolos.keySet()) {
            System.out.println("Tabla de simbolo: " + key);
            System.out.println("Valores :");
            for (String item : listaTablasSimbolos.get(key)) {
                System.out.println(item);
            }
            System.out.println("");
        }
    }

    /*CODIGO NUEVO*/
    public void crearTabla(tipo, id) {
      System.out.println("/++Nueva tabla simbolos funcion o main++/ " + id.toString());
      String tipoTabla = ""
      if (id.toString().equals("main")){
        tipoTabla = "tipo:main:"+tipo.toString();
      } else {
        tipoTabla = "tipo:funcion:"+tipo.toString();
      }

      ArrayList<String> funcionMain = new ArrayList<String>();
      hashActual = id.toString();
      funcionMain.add(tipoTabla)
      listaTablaSimbolos.put(hashActual, funcionMain)
    }
:}


/* ----------------------------------------------------------------------
   3) Declaración de TERMINALES
   (Mapeados a los lexemas navideños según tu lexer.jflex)
---------------------------------------------------------------------- */
terminal IDENTIFICADOR;
terminal INTEGER, FLOAT, BOOL, STRING, CHAR;
terminal L_INTEGER, FLOAT_LITERAL, BOOL_LITERAL, CHAR_LITERAL, STRING_LITERAL;
terminal ASIGNA;  // "entrega"

// Se reintroducen:
terminal INCREMENTO, DECREMENTO, UNKNOWN_TOKEN;

terminal SUMA, RESTA, DIVISION, MULTIPLICACION, MODULE, POTENCIA;
// navidad (+), intercambio (-), reyes (/), nochebuena (*), magos (%), adviento (^)

terminal MENOR, MENOROIGUAL, MAYOR, MAYOROIGUAL, IGUALDAD, DIFERENTE;
// snowball (<), evergreen (<=), minstix (>), upatree (>=), mary (==), openslae (!=)

terminal CONJUNCION, DISYUNCION, NEGACION; // melchor (&&), gaspar (||), baltazar (!)
terminal IF, ELSE, WHILE, FOR, SWITCH, CASE, DEFAULT, BREAK, RETURN, DOS_PUNTOS;
// (elfo, hada, envuelve, duende, varios, historia, ultimo, corta, envia, sigue)

terminal PRINT, READ, MAIN;
terminal ABRECUENTO, CIERRACUENTO, ABREREGALO, CIERRAREGALO, ABREEMPAQUE, CIERRAEMPAQUE;
terminal PUNTO_Y_COMA, COMA;

/*
   No se declara "terminal error;" porque Cup ya provee 'error' internamente
*/

/* ----------------------------------------------------------------------
   4) Declaración de NO TERMINALES
---------------------------------------------------------------------- */
non terminal programa, declaracionesGlobales, globalDeclaracion;
non terminal bloque, lista_sentencias, sentencia;
non terminal declaracion, declaracion_aux, asignacion, tipo_dato;
non terminal control_estructuras, if_estructura, while_estructura, for_estructura, switch_estructura;
non terminal case_blocks, case_block, default_block;
non terminal funcion, parametros, lista_parametros, param_dec;
non terminal expresion;

/* ----------------------------------------------------------------------
   5) Precedencia
---------------------------------------------------------------------- */
precedence right POTENCIA;
precedence right NEGACION, RESTA;
precedence left MULTIPLICACION, DIVISION, MODULE;
precedence left SUMA, RESTA;
precedence left MENOR, MENOROIGUAL, MAYOR, MAYOROIGUAL;
precedence left IGUALDAD, DIFERENTE;
precedence left CONJUNCION;
precedence left DISYUNCION;

/* ----------------------------------------------------------------------
   6) Producción inicial
---------------------------------------------------------------------- */
start with programa;

/* ----------------------------------------------------------------------
   7) Reglas de Producción
---------------------------------------------------------------------- */

/* ----------------------------------------------------------------------
   A) Estructura del Programa
---------------------------------------------------------------------- */
programa ::=
    declaracionesGlobales MAIN bloque
       {: System.out.println("Regla 'programa' con declaracionesGlobales + MAIN"); :}
  | MAIN bloque
       {: System.out.println("Regla 'programa' con sólo MAIN"); :}
  ;

/* declaracionesGlobales -> (globalDeclaracion)+ */
declaracionesGlobales ::=
    declaracionesGlobales globalDeclaracion
  | globalDeclaracion
  ;

/* globalDeclaracion -> declaracion | funcion */
globalDeclaracion ::=
    declaracion
  | funcion
  ;

/* bloque -> { lista_sentencias } | epsilon
   + Manejo de error: si falla, comer hasta '}'
*/
bloque ::=
    ABRECUENTO lista_sentencias CIERRACUENTO
       {: System.out.println("Regla 'bloque' ejecutada."); :}
  | /* epsilon */
  | error CIERRACUENTO
    {:
      System.err.println("Error en bloque. Se ignoraron tokens hasta '}'.");
    :}
  ;

/* lista_sentencias -> (sentencia)+
   + Manejo de error: si falla, comer hasta ';'
*/
lista_sentencias ::=
    lista_sentencias sentencia
      {: System.out.println("Regla 'lista_sentencias' procesando lista."); :}
  | sentencia
      {: System.out.println("Regla 'lista_sentencias' procesando sentencia."); :}
  | error PUNTO_Y_COMA
    {:
      System.err.println("Error en lista de sentencias. Se ignoraron tokens hasta ';'.");
    :}
  ;

/* ----------------------------------------------------------------------
   B) Sentencia
---------------------------------------------------------------------- */
sentencia ::=
    declaracion
  | asignacion
  | control_estructuras
  | PRINT ABREREGALO expresion:e CIERRAREGALO PUNTO_Y_COMA
      {:
         System.out.println("Imprimiendo la expresión: " + (String)e);
      :}
  | READ ABREREGALO IDENTIFICADOR:id CIERRAREGALO PUNTO_Y_COMA
      {:
         System.out.println("Leyendo a variable: " + id);
      :}
  | RETURN expresion:ret PUNTO_Y_COMA
      {:
         System.out.println("Return con expr: " + (String)ret);
      :}
  | BREAK PUNTO_Y_COMA

  /* Manejo de UNKNOWN_TOKEN para evitar "never used" */
  | UNKNOWN_TOKEN:unk
      {:
         System.err.println("Sentencia desconocida: se ignora token " + unk);
      :}
  ;

/* ----------------------------------------------------------------------
   C) Declaraciones (Variables/Arreglos)
---------------------------------------------------------------------- */
declaracion ::=
    tipo_dato:t IDENTIFICADOR:id declaracion_aux:aux
    {:
      System.out.println("Declaración detectada:");
      System.out.println("- Tipo de dato: " + (String)t);
      System.out.println("- Variable: " + id);
      System.out.println("- Inicialización: " + (aux != null? aux : "Ninguna"));
      RESULT = null;
    :}
  ;

/* declaracion_aux:
   1) ;
   2) = expr ;
   3) [ L_INTEGER ] ;
*/
declaracion_aux ::=
    PUNTO_Y_COMA
     {:
       RESULT = null;
     :}
  | ASIGNA expresion:ex PUNTO_Y_COMA
     {:
       RESULT = " = " + ex;
     :}
  | ABREEMPAQUE L_INTEGER:lit CIERRAEMPAQUE PUNTO_Y_COMA
     {:
       RESULT = "[ " + lit + " ]";
     :}
  ;

/* rodolfo->int, bromista->float, trueno->bool, cupido->char, cometa->string */
tipo_dato ::=
    INTEGER  {: RESULT = "int";   :}
  | FLOAT    {: RESULT = "float"; :}
  | BOOL     {: RESULT = "bool";  :}
  | CHAR     {: RESULT = "char";  :}
  | STRING   {: RESULT = "string";:}
  ;

/* ----------------------------------------------------------------------
   D) Asignaciones
---------------------------------------------------------------------- */
asignacion ::=
    IDENTIFICADOR:idVar ASIGNA expresion:ex PUNTO_Y_COMA
      {:
        System.out.println("Asignación simple a variable " + idVar
                           + " con expr: " + ex);
        RESULT = "assign(" + idVar + "=" + ex + ")";
      :}
  | IDENTIFICADOR:idVar ABREEMPAQUE expresion:pos CIERRAEMPAQUE ASIGNA expresion:rhs PUNTO_Y_COMA
      {:
        System.out.println("Asignación a arreglo " + idVar
                           + "[" + pos + "] = " + rhs);
        RESULT = "assignArr(" + idVar + "["+pos+"]="+rhs+")";
      :}
  ;

/* ----------------------------------------------------------------------
   E) Declaración de Funciones
---------------------------------------------------------------------- */
---------------------------------------------------------------------- */
funcion ::=
    tipo_dato:t IDENTIFICADOR:id ABREREGALO parametros:p CIERRAREGALO bloque:b
    {:
      crearTabla(typeFunc, idFunc)
       System.out.println("Función declarada: " + id + " de tipo " + t
                          + ", con params: " + (p != null ? p : "0 params")
                          + " y un bloque.");
       RESULT = "func["+t+" "+id+"("+p+")]";
    :}
  ;

/* parametros -> (lista_parametros)? */
parametros ::=
    /* epsilon */        {: RESULT = ""; :}
  | lista_parametros:p   {: RESULT = p; :}
  ;

/* lista_parametros -> param_dec (, param_dec)* */
lista_parametros ::=
    param_dec:pd
      {:
        RESULT = pd;
      :}
  | lista_parametros:lp COMA param_dec:pd
      {:
        RESULT = (String)lp + ", " + (String)pd;
      :}
  ;

/* param_dec -> tipo_dato IDENTIFICADOR */
param_dec ::=
    tipo_dato:t IDENTIFICADOR:id
      {:
         String paramStr = t + " " + id;
         RESULT = paramStr;
         System.out.println("Parametro: " + paramStr);
      :}
  ;

/* ----------------------------------------------------------------------
   F) Estructuras de Control (if, while, for, switch)
---------------------------------------------------------------------- */
control_estructuras ::=
    if_estructura
  | while_estructura
  | for_estructura
  | switch_estructura
  ;

/* if ( expr ) bloque [ else bloque ] */
if_estructura ::=
    IF ABREREGALO expresion:cond CIERRAREGALO bloque:b
      {:
        RESULT = "if("+cond+")"+b;
      :}
  | IF ABREREGALO expresion:cond CIERRAREGALO bloque:b1 ELSE bloque:b2
      {:
        RESULT = "if("+cond+")"+b1+" else "+b2;
      :}
  ;

/* while ( expr ) bloque */
while_estructura ::=
    WHILE ABREREGALO expresion:cond CIERRAREGALO bloque:bl
      {:
        RESULT = "while("+cond+")"+bl;
      :}
  ;

/* For con comas -> for ( asignacion, expr, expr ) */
for_estructura ::=
    FOR ABREREGALO asignacion:ini COMA expresion:cond COMA expresion:step CIERRAREGALO bloque:bl
      {:
        RESULT = "for("+ini+", "+cond+", "+step+")"+bl;
      :}
  ;

/* switch( expr ) { case_blocks } */
switch_estructura ::=
    SWITCH ABREREGALO expresion:sw CIERRAREGALO ABRECUENTO case_blocks:cs CIERRACUENTO
      {:
        RESULT = "switch("+sw+") { "+cs+" }";
      :}
  ;

case_blocks ::=
    case_blocks:prev case_block:cb
      {:
        RESULT = prev + " " + cb;
      :}
  | case_block:cb
      {:
        RESULT = cb;
      :}
  | default_block:db
      {:
        RESULT = db;
      :}
  ;

case_block ::=
    CASE L_INTEGER:li DOS_PUNTOS bloque:bl
      {:
        RESULT = "case "+li+": "+bl;
      :}
  | CASE CHAR_LITERAL:ch DOS_PUNTOS bloque:bl
      {:
        RESULT = "case '"+ch+"': "+bl;
      :}
  ;

/* default: block */
default_block ::=
    DEFAULT DOS_PUNTOS bloque:bl
      {:
        RESULT = "default: "+bl;
      :}
  ;

/* ----------------------------------------------------------------------
   G) Expresión con precedencia
   y manejo de error (si expr falla, comer hasta ')')
---------------------------------------------------------------------- */
expresion ::=
      expresion:e1 DISYUNCION expresion:e2
        {:
          RESULT = "("+e1+" || "+e2+")";
        :}
    | expresion:e1 CONJUNCION expresion:e2
        {:
          RESULT = "("+e1+" && "+e2+")";
        :}
    | expresion:e1 IGUALDAD expresion:e2
        {:
          RESULT = "("+e1+" == "+e2+")";
        :}
    | expresion:e1 DIFERENTE expresion:e2
        {:
          RESULT = "("+e1+" != "+e2+")";
        :}
    | expresion:e1 MENOR expresion:e2
        {:
          RESULT = "("+e1+" < "+e2+")";
        :}
    | expresion:e1 MENOROIGUAL expresion:e2
        {:
          RESULT = "("+e1+" <= "+e2+")";
        :}
    | expresion:e1 MAYOR expresion:e2
        {:
          RESULT = "("+e1+" > "+e2+")";
        :}
    | expresion:e1 MAYOROIGUAL expresion:e2
        {:
          RESULT = "("+e1+" >= "+e2+")";
        :}
    | expresion:e1 SUMA expresion:e2
        {:
          RESULT = "("+e1+" + "+e2+")";
        :}
    | expresion:e1 RESTA expresion:e2
        {:
          RESULT = "("+e1+" - "+e2+")";
        :}
    | expresion:e1 MULTIPLICACION expresion:e2
        {:
          RESULT = "("+e1+" * "+e2+")";
        :}
    | expresion:e1 DIVISION expresion:e2
        {:
          RESULT = "("+e1+" / "+e2+")";
        :}
    | expresion:e1 MODULE expresion:e2
        {:
          RESULT = "("+e1+" % "+e2+")";
        :}
    | expresion:e1 POTENCIA expresion:e2
        {:
          RESULT = "("+e1+" ^ "+e2+")";
        :}
    /* unarios prefix */
    | NEGACION expresion:e
        {:
          RESULT = "!"+e;
        :}
    | RESTA expresion:e
        {:
          RESULT = "-"+e;
        :}
    /* Manejo de increment/decrement (prefix y postfix) */
    | INCREMENTO IDENTIFICADOR:id
        {:
          RESULT = "++"+id;
          System.out.println("Expresión: ++" + id);
        :}
    | DECREMENTO IDENTIFICADOR:id
        {:
          RESULT = "--"+id;
          System.out.println("Expresión: --" + id);
        :}
    | IDENTIFICADOR:id INCREMENTO
        {:
          RESULT = id + "++";
          System.out.println("Expresión: " + id + "++");
        :}
    | IDENTIFICADOR:id DECREMENTO
        {:
          RESULT = id + "--";
          System.out.println("Expresión: " + id + "--");
        :}
    /* primarios */
    | IDENTIFICADOR:id
        {:
          RESULT = id;
        :}
    | L_INTEGER:lint
        {:
          RESULT = lint.toString();
        :}
    | FLOAT_LITERAL:fli
        {:
          RESULT = fli.toString();
        :}
    | CHAR_LITERAL:chl
        {:
          RESULT = "'"+chl+"'";
        :}
    | STRING_LITERAL:str
        {:
          RESULT = "\""+str+"\"";
        :}
    | BOOL_LITERAL:boo
        {:
          RESULT = boo.toString();
        :}
    | IDENTIFICADOR:id ABREEMPAQUE expresion:ex CIERRAEMPAQUE
        {:
          RESULT = id + "["+ex+"]";
        :}
    | ABREREGALO expresion:ex CIERRAREGALO
        {:
          RESULT = "("+ex+")";
        :}
    /* Manejo de error en expr: si falla, comer tokens hasta ')' */
    | error CIERRAREGALO
      {:
        System.err.println("Error en expresión. Se ignoraron tokens hasta ')'.");
        RESULT = null;
      :}
  ;
